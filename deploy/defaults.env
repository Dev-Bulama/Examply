# Production defaults for https://examply.ng — the LOWEST priority source.
# hPanel environment variables, a .env file and the runtime config (~/.examply/app.env) all override these.
# No secrets here: APP_KEY / SESSION_SECRET / CRON_TOKEN are generated on first boot if you do not set them,
# and database credentials can be entered in the /install wizard.
NODE_ENV=production
APP_NAME=Examply
APP_URL=https://examply.ng
DEFAULT_TIMEZONE=Africa/Lagos
DB_HOST=localhost
DB_PORT=3306
DB_POOL_MAX=10
LOG_LEVEL=info
RUN_SCHEDULER=true
