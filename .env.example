# ---------------------------------------------------------------------------
# EXAMPLY — environment configuration
# Copy to .env (local) or enter each variable in hPanel → Node.js → Environment.
# ---------------------------------------------------------------------------

# development | production | test
NODE_ENV=production

# Port is assigned by hPanel; keep the fallback for local development.
PORT=3000

# Public base URL, no trailing slash. Used in emails, QR codes, webhooks.
APP_URL=http://localhost:3000

# 32-byte key, base64. Encrypts secrets at rest (Paystack secret, SMTP password, 2FA secrets).
# Generate with: npm run key:generate   — NEVER change it after install, or encrypted settings become unreadable.
APP_KEY=

# Long random string used to sign the session cookie (npm run key:generate prints one too).
SESSION_SECRET=

# Token required by GET /cron/run?token=... (hPanel Cron Job). Long random string.
CRON_TOKEN=

# --- Database (MySQL 8 / MariaDB 10.6+) ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=skillscore
DB_PASSWORD=
DB_NAME=skillscore
# Optional: pool size (shared hosting usually allows ~10–25 connections)
DB_POOL_MAX=10

# --- Defaults ---
# Site timezone default (can be changed later in Settings → General)
DEFAULT_TIMEZONE=Africa/Lagos

# pino level: fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# Optional: absolute path for writable storage (defaults to ./storage)
STORAGE_PATH=

# Optional: set to "false" to disable the in-process cron scheduler and job poller
# (e.g. if you rely only on the hPanel Cron Job calling /cron/run).
RUN_SCHEDULER=true

# --- Optional: first Super Admin for `npm run seed` / `npm run create-admin` (the /install wizard is the normal path) ---
SUPERADMIN_EMAIL=
SUPERADMIN_PASSWORD=
SUPERADMIN_NAME=
