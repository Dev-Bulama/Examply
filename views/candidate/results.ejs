<div class="mb-6">
  <h1 class="h1">My exams &amp; results</h1>
  <p class="mt-1 muted">Every attempt you have started, with its result.</p>
</div>
<div class="card overflow-hidden">
  <% if (!rows.length) { %>
    <div class="flex flex-col items-center px-6 py-16 text-center"><p class="font-semibold">You have not taken any exams yet</p><p class="mt-1 text-sm muted">Find a diagnostic, mock exam or practice test in the catalogue.</p><a href="/exams" class="btn-primary mt-4">Browse exams</a></div>
  <% } else { %>
  <div class="overflow-x-auto p-2 sm:p-0">
    <table class="table table-responsive">
      <thead><tr><th>Exam</th><th>Status</th><th>Result</th><th><span class="sr-only">Actions</span></th></tr></thead>
      <tbody>
      <% rows.forEach(function (r) { const open = r.status === 'in_progress'; %>
        <tr>
          <td data-label="Exam"><p class="font-medium"><%= r.title %></p><p class="text-xs muted"><%= r.mode === 'study' ? 'Weak-area practice' : 'Attempt ' + r.attempt_no %> · <%= fmt.dateTime(r.started_at) %></p></td>
          <td data-label="Status"><% if (open) { %><span class="badge-blue">In progress</span><% } else if (r.has_pending_manual) { %><span class="badge-amber">Grading</span><% } else if (r.release_status === 'withheld') { %><span class="badge-gray">Awaiting release</span><% } else { %><span class="badge-green">Completed</span><% } %></td>
          <td data-label="Result" class="text-sm"><% if (!open && r.release_status === 'released') { %><span class="font-semibold"><%= Number(r.percent) %>%</span> <%= r.mode === 'study' ? '' : r.passed === null ? (r.band || '') : r.passed ? '· Pass' : '· Fail' %><% if (r.certificate_code) { %> <span class="badge-green">Certificate</span><% } %><% } else { %>—<% } %></td>
          <td data-label="Actions" class="text-right"><a class="btn-secondary btn-sm" href="<%= open ? '/attempts/' + r.uuid : '/results/' + r.uuid %>"><%= open ? 'Resume' : 'View' %></a></td>
        </tr>
      <% }) %>
      </tbody>
    </table>
  </div>
  <% } %>
</div>
