<div class="mb-6"><h1 class="h1">My certificates</h1><p class="mt-1 muted">Each certificate has a unique ID and a public verification page you can share with employers.</p></div>
<% if (!rows.length) { %>
  <div class="card card-body flex flex-col items-center py-16 text-center"><span class="grid h-12 w-12 place-items-center rounded-full bg-slate-100 text-slate-500 dark:bg-slate-800"><%- include('../partials/icon', { name: 'academic' }) %></span><p class="mt-4 font-semibold">No certificates yet</p><p class="mt-1 text-sm muted">Pass an exam that awards a certificate and it will appear here.</p><a href="/exams" class="btn-primary mt-4">Browse exams</a></div>
<% } else { %>
<ul class="grid gap-4 md:grid-cols-2">
  <% rows.forEach(function (c) { %>
  <li class="card card-body">
    <div class="flex items-start justify-between gap-3"><div><p class="text-xs font-semibold uppercase tracking-wide text-primary-700 dark:text-primary-300">Certificate</p><h2 class="mt-1 font-semibold"><%= c.exam_title %></h2></div><% if (c.revoked_at) { %><span class="badge-red">Revoked</span><% } else { %><span class="badge-green">Valid</span><% } %></div>
    <p class="mt-2 text-sm muted"><%= Number(c.percent) %>% · issued <%= fmt.date(c.issued_at) %> · <span class="font-mono"><%= c.code %></span></p>
    <% if (!c.revoked_at) { %><div class="mt-4 flex flex-wrap gap-2"><a class="btn-primary btn-sm" href="/certificates/<%= c.code %>.pdf">Download PDF</a><a class="btn-secondary btn-sm" href="/verify/<%= c.code %>">Verification page</a><a class="btn-secondary btn-sm" target="_blank" rel="noopener" href="https://www.linkedin.com/sharing/share-offsite/?url=<%= encodeURIComponent(verifyUrl(c.code)) %>">Share on LinkedIn</a></div><% } %>
  </li>
  <% }) %>
</ul>
<% } %>
