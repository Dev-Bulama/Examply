<div class="mb-8 flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
  <div>
    <p class="text-sm muted"><%= fmt.date(new Date()) %></p>
    <h1 class="h1 mt-1">Welcome, <%= user.full_name.split(' ')[0] %></h1>
  </div>
</div>

<div class="grid gap-4 sm:grid-cols-3">
  <% [['clock', 'Exams in progress', counts.inProgress], ['chart', 'Results', counts.results], ['academic', 'Certificates', counts.certificates]].forEach(function (k) { %>
  <div class="card card-body flex items-center gap-4">
    <span class="grid h-11 w-11 place-items-center rounded-lg bg-primary-50 text-primary-700 dark:bg-primary-950 dark:text-primary-300"><%- include('../partials/icon', { name: k[0] }) %></span>
    <div><p class="text-2xl font-bold"><%= k[2] %></p><p class="text-sm muted"><%= k[1] %></p></div>
  </div>
  <% }) %>
</div>

<% if (assigned.length) { %>
<section class="card card-body mt-6" aria-labelledby="asg">
  <h2 id="asg" class="h2">Assigned to you</h2>
  <ul class="mt-3 divide-y divide-slate-200 dark:divide-slate-800">
    <% assigned.forEach(function (a) { const overdue = a.due_at && new Date(a.due_at) < new Date() && a.best === null; %>
    <li class="flex flex-wrap items-center justify-between gap-3 py-3">
      <div class="min-w-0"><p class="font-medium"><%= a.title %></p><p class="text-xs muted"><%= a.organisation_name %> · <%= a.cohort_name %><%= a.kind === 'pre' ? ' · pre-training' : a.kind === 'post' ? ' · post-training' : '' %></p></div>
      <div class="flex items-center gap-3">
        <% if (a.best !== null) { %><span class="badge-green">Done · <%= Number(a.best) %>%</span><% } else if (a.due_at) { %><span class="<%= overdue ? 'badge-red' : 'badge-amber' %>"><%= overdue ? 'Overdue' : 'Due ' + fmt.dateTime(a.due_at) %></span><% } %>
        <a class="<%= a.best === null ? 'btn-primary' : 'btn-secondary' %> btn-sm" href="/exams/<%= a.slug %>"><%= a.best === null ? 'Start' : 'Open' %></a>
      </div>
    </li>
    <% }) %>
  </ul>
</section>
<% } %>

<div class="mt-6 grid gap-6 lg:grid-cols-3">
  <section class="card lg:col-span-2">
    <div class="card-body">
      <div class="flex items-center justify-between"><h2 class="h2">Your assessments</h2><% if (recent.length) { %><a href="/my/results" class="text-sm link">See all</a><% } %></div>
      <% if (recent.length) { %>
      <ul class="mt-4 divide-y divide-slate-200 dark:divide-slate-800">
        <% recent.forEach(function (r) { const open = r.status === 'in_progress'; %>
        <li class="flex flex-wrap items-center justify-between gap-3 py-3">
          <div class="min-w-0"><p class="truncate font-medium"><%= r.title %></p><p class="text-xs muted"><%= r.mode === 'study' ? 'Weak-area practice' : 'Attempt ' + r.attempt_no %> · <%= fmt.relative(r.started_at) %></p></div>
          <div class="flex items-center gap-3">
            <% if (open) { %><span class="badge-blue">In progress</span><a class="btn-primary btn-sm" href="/attempts/<%= r.uuid %>">Resume</a>
            <% } else if (r.release_status === 'released') { %><span class="text-sm font-semibold"><%= Number(r.percent) %>%<%= r.mode === 'study' ? '' : r.passed === null ? (r.band ? ' · ' + r.band : '') : r.passed ? ' · Pass' : ' · Fail' %></span><a class="btn-secondary btn-sm" href="/results/<%= r.uuid %>">View</a>
            <% } else { %><span class="badge-gray"><%= r.has_pending_manual ? 'Being graded' : 'Awaiting release' %></span><a class="btn-secondary btn-sm" href="/results/<%= r.uuid %>">View</a><% } %>
          </div>
        </li>
        <% }) %>
      </ul>
      <% } else { %>
      <div class="mt-6 flex flex-col items-center rounded-xl border border-dashed border-slate-300 px-6 py-12 text-center dark:border-slate-700">
        <span class="grid h-12 w-12 place-items-center rounded-full bg-slate-100 text-slate-500 dark:bg-slate-800"><%- include('../partials/icon', { name: 'clipboard' }) %></span>
        <p class="mt-4 font-semibold">No assessments yet</p>
        <p class="mt-1 max-w-sm text-sm muted">Start a diagnostic, mock exam or practice test from the catalogue. Exams your organisation assigns will appear here too.</p>
        <a href="/exams" class="btn-primary mt-4">Browse exams</a>
      </div>
      <% } %>
      <% if (suggested.length) { %>
      <h3 class="h3 mt-8">Popular exams</h3>
      <ul class="mt-3 grid gap-3 sm:grid-cols-3"><% suggested.forEach(function (e) { %><li><a href="/exams/<%= e.slug %>" class="block rounded-lg border border-slate-200 p-3 text-sm hover:border-primary-300 dark:border-slate-700"><span class="font-medium"><%= e.title %></span><span class="mt-1 block text-xs muted"><%= e.duration_minutes ? e.duration_minutes + ' min' : 'Untimed' %> · <%= e.is_paid ? 'Paid' : 'Free' %></span></a></li><% }) %></ul>
      <% } %>
    </div>
  </section>

  <aside class="space-y-6">
    <section class="card card-body">
      <div class="flex items-center justify-between">
        <h2 class="h3">Profile</h2>
        <span class="text-sm font-semibold"><%= completeness %>%</span>
      </div>
      <div class="mt-3 h-2 overflow-hidden rounded-full bg-slate-100 dark:bg-slate-800" role="progressbar" aria-valuenow="<%= completeness %>" aria-valuemin="0" aria-valuemax="100" aria-label="Profile completeness">
        <div class="h-full rounded-full bg-primary-600 <%= ['w-0','w-1/12','w-2/12','w-3/12','w-4/12','w-5/12','w-6/12','w-7/12','w-8/12','w-9/12','w-10/12','w-11/12','w-full'][Math.round(completeness / 100 * 12)] %>"></div>
      </div>
      <% if (missing.length) { %>
        <p class="mt-3 text-sm muted">Add: <%= missing.join(', ') %>.</p>
        <a href="/account" class="btn-secondary btn-sm mt-4">Complete profile</a>
      <% } else { %>
        <p class="mt-3 text-sm muted">Your profile is complete.</p>
      <% } %>
    </section>
    <section class="card card-body">
      <h2 class="h3">Account security</h2>
      <ul class="mt-3 space-y-2 text-sm">
        <li class="flex items-center gap-2"><%- include('../partials/icon', { name: user.email_verified_at ? 'check' : 'warning', cls: `h-4 w-4 ${user.email_verified_at ? 'text-emerald-600' : 'text-amber-600'}` }) %> Email <%= user.email_verified_at ? 'verified' : 'not verified' %></li>
        <li class="flex items-center gap-2"><%- include('../partials/icon', { name: user.totp_enabled_at ? 'check' : 'info', cls: `h-4 w-4 ${user.totp_enabled_at ? 'text-emerald-600' : 'text-slate-400'}` }) %> Two-factor <%= user.totp_enabled_at ? 'on' : 'off' %></li>
      </ul>
      <a href="/account/security" class="mt-4 inline-block text-sm link">Manage security</a>
    </section>
    <section class="card card-body">
      <h2 class="h3">Training with a company?</h2>
      <p class="mt-1 text-sm muted">Got a join code from your employer or trainer?</p>
      <a href="/join" class="btn-secondary btn-sm mt-3">Join an organisation</a>
    </section>
  </aside>
</div>
