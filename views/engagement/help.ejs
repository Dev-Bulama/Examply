<section class="border-b border-slate-200 bg-white dark:border-slate-800 dark:bg-slate-950">
  <div class="container-page py-12 text-center">
    <h1 class="text-3xl font-bold tracking-tight sm:text-4xl">Help centre</h1>
    <p class="mx-auto mt-3 max-w-xl muted">Answers to common questions about exams, results, payments and company workspaces.</p>
    <a href="/support" class="btn-primary mt-6">Contact support</a>
  </div>
</section>
<section class="container-page max-w-3xl py-10">
  <% if (!groups.length) { %><p class="text-center muted">No FAQs yet. <a class="link" href="/support">Ask us directly</a>.</p><% } %>
  <% groups.forEach(function (g) { %>
    <h2 class="mt-8 text-lg font-semibold first:mt-0"><%= g.name %></h2>
    <div class="mt-3 space-y-2">
      <% g.items.forEach(function (f) { %>
      <details class="card group">
        <summary class="flex cursor-pointer list-none items-center justify-between gap-4 px-5 py-4 font-medium"><%= f.question %><span class="text-slate-400 transition group-open:rotate-45" aria-hidden="true">+</span></summary>
        <div class="prose-content px-5 pb-5 text-sm leading-relaxed text-slate-700 dark:text-slate-300"><%- f.answer_html %></div>
      </details>
      <% }) %>
    </div>
  <% }) %>
</section>
