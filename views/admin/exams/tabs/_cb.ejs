<%
/* Checkbox without the hidden "0" twin (unchecked = absent = false). Locals: name, label, checked, hint */
const cid = 'cb-' + name.replace(/[^a-z0-9]+/gi, '-');
%>
<label class="flex items-start gap-3 text-sm" for="<%= cid %>">
  <input id="<%= cid %>" type="checkbox" name="<%= name %>" value="1" class="checkbox mt-0.5" <%= checked ? 'checked' : '' %>>
  <span><span class="font-medium"><%= label %></span><% if (locals.hint) { %><span class="mt-0.5 block text-xs muted"><%= hint %></span><% } %></span>
</label>
