<%
  const editable = can('exams.manage');
  const openItems = checklist.filter(function (c) { return !c.ok; });
  const blockers = openItems.filter(function (c) { return c.level === 'error'; });
  const settingsTabs = ['basics','timing','attempts','delivery','scoring','release','integrity','certificate'];
%>
<div class="mb-5 flex flex-col gap-3 lg:flex-row lg:items-start lg:justify-between">
  <div class="min-w-0">
    <div class="flex flex-wrap items-center gap-2">
      <span class="<%= STATUS_BADGE[e.status] %>"><%= e.status[0].toUpperCase() + e.status.slice(1) %><%= e.status === 'published' ? ' · v' + e.version : '' %></span>
      <span class="badge-gray"><%= EXAM_TYPES[e.type] %></span>
      <% if (e.ai_generation_id) { %><span class="badge-blue">Drafted by AI</span><% } %>
    </div>
    <h1 class="h1 mt-2 break-words"><%= e.title %></h1>
    <p class="mt-1 text-sm muted"><%= summary.questionCount %> question<%= summary.questionCount === 1 ? '' : 's' %> · <%= summary.totalMarks %> marks · <%= summary.durationMinutes ? summary.durationMinutes + ' min' : 'untimed' %><%= summary.passMark !== null ? ' · pass ' + summary.passMark + (summary.passMarkType === 'raw' ? ' marks' : '%') : '' %></p>
  </div>
  <div class="flex flex-wrap gap-2">
    <% if (can('attempts.view')) { %><a href="/admin/attempts?exam=<%= e.id %>" class="btn-secondary">Attempts</a><% } %>
    <a href="/admin/exams/<%= e.id %>/instructions" class="btn-secondary"><%- include('../../partials/icon', { name: 'eye', cls: 'h-4 w-4' }) %> Candidate instructions</a>
    <% if (can('exams.publish')) { %><a href="/admin/exams/<%= e.id %>/publish" class="<%= blockers.length ? 'btn-secondary' : 'btn-primary' %>"><%= e.status === 'published' ? (unpublishedChanges ? 'Publish changes' : 'Published') : 'Publish' %><% if (blockers.length) { %> <span class="badge-amber"><%= blockers.length %> to fix</span><% } %></a><% } %>
  </div>
</div>

<% if (unpublishedChanges) { %>
<div class="alert-warning mb-5" role="status"><p>You have changes that candidates do not see yet. Candidates get version <%= e.version %> until you <a class="font-semibold underline" href="/admin/exams/<%= e.id %>/publish">publish the changes</a>.</p></div>
<% } %>

<nav class="-mx-4 mb-6 overflow-x-auto border-b border-slate-200 px-4 dark:border-slate-800 sm:mx-0 sm:px-0" aria-label="Exam builder">
  <ul class="flex min-w-max gap-1">
    <% TABS.forEach(function (t) { const issue = (t[0] === 'content' && checklist.some(function (c) { return !c.ok && c.level === 'error' && ['content','published_only','blueprint_satisfiable','sections','deliver_count'].includes(c.key); })) || (t[0] === 'scoring' && checklist.some(function (c) { return !c.ok && c.level === 'error' && ['pass_mark','bands','scaling','pass_mark_range'].includes(c.key); })) || (t[0] === 'timing' && checklist.some(function (c) { return !c.ok && c.level === 'error' && ['duration','window','section_timers'].includes(c.key); })); %>
    <li><a href="/admin/exams/<%= e.id %>/<%= t[0] %>" class="relative inline-flex items-center gap-1.5 whitespace-nowrap border-b-2 px-3 py-2.5 text-sm font-medium <%= tab === t[0] ? 'border-primary-600 text-primary-700 dark:text-primary-300' : 'border-transparent text-slate-600 hover:text-slate-900 dark:text-slate-400 dark:hover:text-white' %>" <%= tab === t[0] ? 'aria-current="page"' : '' %>><%= t[1] %><% if (issue) { %><span class="h-2 w-2 rounded-full bg-amber-500" aria-label="needs attention"></span><% } %></a></li>
    <% }) %>
  </ul>
</nav>

<div class="grid gap-6 xl:grid-cols-[minmax(0,1fr)_18rem]">
  <div class="min-w-0 space-y-6">
    <% if (settingsTabs.includes(tab)) { %>
    <form method="post" action="/admin/exams/<%= e.id %>/tab/<%= tab %>" class="card" novalidate x-data="autosave" data-autosave="<%= editable ? '1' : '' %>">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <fieldset class="card-body space-y-5" <%= editable ? '' : 'disabled' %>>
        <div class="flex items-center justify-between gap-3">
          <h2 class="h2"><%= TABS.find(function (t) { return t[0] === tab; })[1] %></h2>
          <p class="text-xs muted" aria-live="polite"><span x-text="statusText()"><%= editable ? 'Changes save automatically' : 'Read only' %></span></p>
        </div>
        <div class="alert-danger" x-show="hasErrors()" x-cloak role="alert"><ul class="list-disc pl-5"><template x-for="m in messages" :key="m"><li x-text="m"></li></template></ul></div>
        <%- include('tabs/' + tab) %>
      </fieldset>
      <% if (editable) { %><div class="flex justify-end border-t border-slate-200 px-5 py-3 dark:border-slate-800"><button class="btn-primary">Save</button></div><% } %>
    </form>
    <% } %>
    <%- include('tabs/' + tab + '-extra', {}) %>
  </div>

  <aside class="space-y-4" aria-label="Exam summary">
    <div class="card card-body">
      <h2 class="h3">Ready to publish?</h2>
      <% if (!blockers.length) { %>
        <p class="mt-2 flex items-center gap-2 text-sm text-emerald-700 dark:text-emerald-400"><%- include('../../partials/icon', { name: 'check', cls: 'h-4 w-4' }) %> All required checks pass.</p>
      <% } else { %>
        <p class="mt-2 text-sm"><%= blockers.length %> thing<%= blockers.length === 1 ? '' : 's' %> to fix:</p>
      <% } %>
      <ul class="mt-3 space-y-2 text-sm">
        <% openItems.slice(0, 6).forEach(function (c) { %>
        <li class="flex gap-2"><span class="mt-0.5 shrink-0 <%= c.level === 'error' ? 'text-red-600' : 'text-amber-500' %>"><%- include('../../partials/icon', { name: 'warning', cls: 'h-4 w-4' }) %></span><span><%= c.message %></span></li>
        <% }) %>
      </ul>
      <a href="/admin/exams/<%= e.id %>/publish" class="mt-4 inline-block text-sm font-semibold text-primary-700 hover:underline dark:text-primary-300">Full checklist →</a>
    </div>
    <div class="card card-body text-sm">
      <h2 class="h3">At a glance</h2>
      <dl class="mt-3 grid grid-cols-2 gap-x-3 gap-y-2">
        <dt class="muted">Questions</dt><dd class="text-right font-medium"><%= summary.questionCount %></dd>
        <dt class="muted">Total marks</dt><dd class="text-right font-medium"><%= summary.totalMarks %></dd>
        <dt class="muted">Duration</dt><dd class="text-right font-medium"><%= summary.durationMinutes ? summary.durationMinutes + ' min' : '—' %></dd>
        <dt class="muted">Pass mark</dt><dd class="text-right font-medium"><%= summary.passMark !== null ? summary.passMark + (summary.passMarkType === 'raw' ? '' : '%') : '—' %></dd>
        <dt class="muted">Attempts</dt><dd class="text-right font-medium"><%= summary.maxAttempts || 'Unlimited' %></dd>
        <dt class="muted">Price</dt><dd class="text-right font-medium"><%= e.is_paid ? fmt.money(e.price_kobo) : 'Free' %></dd>
        <dt class="muted">Certificate</dt><dd class="text-right font-medium"><%= e.certificate_enabled ? 'Yes' : 'No' %></dd>
      </dl>
      <% if (summary.questionTypes.length) { %><div class="mt-3 flex flex-wrap gap-1"><% summary.questionTypes.forEach(function (t) { %><span class="badge-gray"><%= QTYPES[t] ? QTYPES[t].short : t %></span><% }) %></div><% } %>
    </div>
  </aside>
</div>
