<script src="/vendor/katex/katex.min.js"></script><script src="/vendor/katex/auto-render.min.js"></script><script src="/vendor/highlight/highlight.min.js"></script><script src="/js/question-render.js"></script>
<link rel="stylesheet" href="/vendor/katex/katex.min.css"><link rel="stylesheet" href="/vendor/highlight/github.min.css">
<div class="mb-6">
  <h1 class="h1">Question #<%= q.id %> · version <%= v.version.version_no %> <% if (isCurrent) { %><span class="badge-blue align-middle">current</span><% } %></h1>
  <p class="mt-1 text-sm muted">Saved <%= fmt.dateTime(v.version.created_at) %><%= v.version.published_at ? ` · first live ${fmt.dateTime(v.version.published_at)}` : ' · never published' %><%= v.version.change_note ? ` · “${v.version.change_note}”` : '' %></p>
</div>
<div class="grid gap-6 lg:grid-cols-5">
  <section class="card card-body lg:col-span-3"><%- include('../../questions/render', { view: view, name: 'v', interactive: false }) %></section>
  <section class="card card-body lg:col-span-2"><h2 class="h3">Answer key</h2><div class="mt-3"><%- include('_answer-key', { a: v.authoring }) %></div>
    <% if (v.authoring.explanation_html) { %><h3 class="h3 mt-6">Explanation</h3><div class="q-content prose-content mt-2 max-w-none text-sm"><%- v.authoring.explanation_html %></div><% } %>
  </section>
</div>
<p class="mt-6"><a class="link" href="/admin/questions/<%= q.id %>">← Back to the question</a></p>
