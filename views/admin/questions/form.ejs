<%
  const t = authoring.type;
  const isNew = !question;
  const errFor = function (prefix) { return errorList.filter(function (e) { return e.field === prefix || e.field.startsWith(prefix + '.'); }); };
  const typeErrors = errorList.filter(function (e) { return !['stem_html','explanation_html','marks','category_id','certification_id','domain_id','difficulty','bloom_level','est_time_sec','parent_id','reference'].includes(e.field); });
  const modelJson = JSON.stringify({ model: authoring, certifications: certifications.map(function (c) { return { id: c.id, name: c.name, code: c.exam_code, domains: c.domains.map(function (d) { return { id: d.id, label: (d.code ? d.code + ' · ' : '') + d.name }; }) }; }), certification_id: meta.certification_id || '', domain_id: meta.domain_id || '' });
  const actionUrl = isNew ? '/admin/questions' : `/admin/questions/${question.id}`;
%>
<link rel="stylesheet" href="/vendor/katex/katex.min.css">
<script type="application/json" id="question-editor-data"><%- modelJson.replace(/</g, '\\u003c') %></script>

<div class="mb-6 flex flex-col gap-2 sm:flex-row sm:items-end sm:justify-between">
  <div>
    <h1 class="h1"><%= isNew ? 'New question' : `Edit question #${question.id}` %></h1>
    <p class="mt-1 muted"><%= TYPES[t].label %><%= parent ? ` · inside case study #${parent.id}` : '' %><%= !isNew ? ` · version ${question.version}` : '' %></p>
  </div>
  <% if (!isNew) { %><a href="/admin/questions/<%= question.id %>" class="btn-ghost">Cancel</a><% } %>
</div>

<% if (errorList.length) { %>
  <div class="alert-danger mb-6" role="alert" tabindex="-1" id="error-summary">
    <%- include('../../partials/icon', { name: 'warning', cls: 'h-5 w-5 shrink-0' }) %>
    <div><p class="font-semibold">Please fix <%= errorList.length === 1 ? 'this problem' : `these ${errorList.length} problems` %>:</p>
      <ul class="mt-1 list-disc space-y-0.5 pl-5"><% errorList.forEach(function (e) { %><li><%= e.message %></li><% }) %></ul></div>
  </div>
<% } %>

<% if (lockedType) { %>
  <div class="alert-info mb-6"><%- include('../../partials/icon', { name: 'info', cls: 'h-5 w-5 shrink-0' }) %><p>This question has been live. Saving creates <strong>version <%= question.version + 1 %></strong>; attempts already taken keep the version they answered.</p></div>
<% } %>

<form method="post" action="<%= actionUrl %>" x-data="questionEditor" @submit="serialize" novalidate class="grid gap-6 lg:grid-cols-3">
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
  <input type="hidden" name="type" value="<%= t %>">
  <input type="hidden" name="payload" x-ref="payload">
  <% if (meta.parent_id) { %><input type="hidden" name="parent_id" value="<%= meta.parent_id %>"><% } %>

  <div class="space-y-6 lg:col-span-2">
    <section class="card card-body">
      <%- include('_rich', { name: 'stem_html', label: t === 'case_study' ? 'Scenario / passage' : 'Question text', value: authoring.stem_html, required: true, blanks: t === 'fill_blank', minHeight: t === 'case_study' ? 'min-h-[14rem]' : 'min-h-[8rem]', hint: t === 'fill_blank' ? 'Use “+ Blank” to add [[1]], [[2]]… where the candidate types an answer. Maths: \\( x^2 \\) inline or \\[ … \\] on its own line.' : 'Maths: \\( x^2 \\) inline or \\[ … \\] on its own line. Paste or upload images; tables and code blocks are supported.' }) %>
    </section>

    <% if (t !== 'case_study') { %>
    <section class="card card-body" aria-labelledby="answer-h">
      <h2 id="answer-h" class="h2">Answer</h2>
      <% if (typeErrors.length) { %><ul class="mt-2 space-y-1"><% typeErrors.forEach(function (e) { %><li class="field-error mt-0"><%= e.message %></li><% }) %></ul><% } %>

      <% if (t === 'single_choice' || t === 'multiple_response') { %>
        <p class="mt-1 text-sm muted"><%= t === 'single_choice' ? 'Select the one correct option.' : 'Tick every correct option.' %> Use `backticks` for code and \( … \) for maths. Options are shuffled per attempt unless pinned.</p>
        <ol class="mt-4 space-y-3">
          <template x-for="(o, i) in m.options" :key="o.uid">
            <li class="rounded-xl border p-3" :class="o.correct ? 'border-emerald-400 bg-emerald-50/60 dark:border-emerald-700 dark:bg-emerald-950/30' : 'border-slate-200 dark:border-slate-700'">
              <div class="flex items-start gap-3">
                <button type="button" class="mt-1.5 grid h-7 w-7 shrink-0 place-items-center rounded-full border text-xs font-bold" :class="o.correct ? 'border-emerald-600 bg-emerald-600 text-white' : 'border-slate-300 text-slate-600 dark:border-slate-600 dark:text-slate-300'" @click="toggleCorrect(i)" :aria-pressed="o.correct" :aria-label="'Mark option ' + (letter(i)) + ' correct'" x-text="letter(i)"></button>
                <div class="min-w-0 flex-1 space-y-2">
                  <label class="sr-only" :for="'opt-' + (i)" x-text="'Option ' + (letter(i))"></label>
                  <input :id="'opt-' + (i)" class="input" x-model="o.text" maxlength="2000" placeholder="Option text">
                  <div class="flex flex-wrap items-center gap-x-4 gap-y-1 text-xs">
                    <label class="flex items-center gap-1.5"><input type="checkbox" class="checkbox" x-model="o.pin_last" @change="pinOnly(i)"> Pin last (e.g. “All of the above”)</label>
                    <button type="button" class="link" @click="o.showFeedback = !o.showFeedback" x-text="o.showFeedback || o.feedback ? 'Feedback' : '+ Feedback'"></button>
                  </div>
                  <input class="input text-xs" x-show="o.showFeedback || o.feedback" x-model="o.feedback" maxlength="1000" placeholder="Shown in review when this option was chosen" :aria-label="'Feedback for option ' + (letter(i))">
                </div>
                <div class="flex shrink-0 items-center">
                  <button type="button" class="btn-ghost btn-sm px-2" @click="move('options', i, -1)" :disabled="i === 0" aria-label="Move up">↑</button>
                  <button type="button" class="btn-ghost btn-sm px-2" @click="move('options', i, 1)" :disabled="i === m.options.length - 1" aria-label="Move down">↓</button>
                  <button type="button" class="btn-ghost btn-sm px-2 text-red-600" @click="remove('options', i)" :disabled="m.options.length <= 2" aria-label="Remove option">✕</button>
                </div>
              </div>
            </li>
          </template>
        </ol>
        <div class="mt-4 flex flex-wrap items-center gap-4">
          <button type="button" class="btn-secondary btn-sm" @click="addOption" :disabled="m.options.length >= 12">+ Add option</button>
          <% if (t === 'multiple_response') { %>
          <label class="flex items-center gap-2 text-sm">Candidates must select exactly
            <input type="number" min="1" max="12" class="input w-20 py-1.5" x-model="m.select_exact" placeholder="any" aria-label="Select exactly"></label>
          <% } %>
        </div>
      <% } else if (t === 'true_false') { %>
        <div class="mt-4 grid gap-3 sm:grid-cols-2">
          <% [[true, 'True', 'feedback_true'], [false, 'False', 'feedback_false']].forEach(function (o) { %>
          <div class="rounded-xl border p-4" :class="m.correct === <%= o[0] %> ? 'border-emerald-400 bg-emerald-50/60 dark:border-emerald-700 dark:bg-emerald-950/30' : 'border-slate-200 dark:border-slate-700'">
            <label class="flex items-center gap-2 font-semibold"><input type="radio" name="tf_choice" class="checkbox rounded-full" :checked="m.correct === <%= o[0] %>" @change="m.correct = <%= o[0] %>"> <%= o[1] %> is correct</label>
            <input class="input mt-3 text-xs" x-model="m.<%= o[2] %>" maxlength="1000" placeholder="Feedback if the candidate answers “<%= o[1] %>” (optional)" aria-label="Feedback for <%= o[1] %>">
          </div>
          <% }) %>
        </div>
      <% } else if (t === 'fill_blank') { %>
        <p class="mt-1 text-sm muted">One row per blank in the question text. Separate alternative accepted answers with <kbd class="rounded bg-slate-100 px-1 dark:bg-slate-800">|</kbd>.</p>
        <div class="mt-4 space-y-3">
          <template x-for="(b, i) in m.blanks" :key="i">
            <div class="flex items-center gap-3"><span class="w-12 shrink-0 font-mono text-sm font-semibold" x-text="'[[' + (i + 1) + ']]'"></span>
              <input class="input" x-model="b.text" placeholder="e.g. 1521 | port 1521" :aria-label="'Accepted answers for blank ' + (i + 1)"></div>
          </template>
          <p class="rounded-lg border border-dashed border-slate-300 p-4 text-center text-sm muted dark:border-slate-700" x-show="!m.blanks.length">Add blanks to the question text with “+ Blank”.</p>
        </div>
        <div class="mt-4 flex flex-wrap gap-6 text-sm">
          <label class="flex items-center gap-2"><input type="checkbox" class="checkbox" x-model="m.case_sensitive"> Case-sensitive</label>
          <label class="flex items-center gap-2"><input type="checkbox" class="checkbox" x-model="m.trim_whitespace"> Ignore extra spaces</label>
        </div>
      <% } else if (t === 'numeric') { %>
        <div class="mt-4 grid gap-4 sm:grid-cols-3">
          <div><label class="label" for="num-v">Correct value</label><input id="num-v" type="number" step="any" class="input" x-model="m.value" required></div>
          <div><label class="label" for="num-t">Tolerance ±</label><input id="num-t" type="number" step="any" min="0" class="input" x-model="m.tolerance"><p class="hint">0 = exact</p></div>
          <div><label class="label" for="num-u">Units (shown to candidates)</label><input id="num-u" class="input" x-model="m.units" maxlength="40" placeholder="e.g. ms, %, ₦"></div>
        </div>
        <p class="mt-3 text-sm muted" x-show="m.value !== null && m.value !== ''" x-text="acceptRange()"></p>
      <% } else if (t === 'matching') { %>
        <p class="mt-1 text-sm muted">Each left item has one correct match on the right. Right-hand items are shuffled for candidates. Add distractors to make guessing harder.</p>
        <div class="mt-4 space-y-2">
          <template x-for="(p, i) in m.pairs" :key="p.uid">
            <div class="grid grid-cols-[1fr_auto_1fr_auto] items-center gap-2">
              <input class="input" x-model="p.left" placeholder="Left item" :aria-label="'Left item ' + (i + 1)" maxlength="500">
              <span class="muted" aria-hidden="true">→</span>
              <input class="input" x-model="p.right" placeholder="Correct match" :aria-label="'Match for item ' + (i + 1)" maxlength="500">
              <button type="button" class="btn-ghost btn-sm px-2 text-red-600" @click="remove('pairs', i)" :disabled="m.pairs.length <= 2" aria-label="Remove pair">✕</button>
            </div>
          </template>
        </div>
        <button type="button" class="btn-secondary btn-sm mt-3" @click="addPair">+ Add pair</button>
        <h3 class="h3 mt-6">Distractors <span class="text-sm font-normal muted">(extra right-hand items with no match)</span></h3>
        <div class="mt-2 space-y-2">
          <template x-for="(d, i) in m.distractors" :key="d.uid">
            <div class="flex gap-2"><input class="input" x-model="d.text" placeholder="Distractor" maxlength="500" :aria-label="'Distractor ' + (i + 1)"><button type="button" class="btn-ghost btn-sm px-2 text-red-600" @click="remove('distractors', i)" aria-label="Remove distractor">✕</button></div>
          </template>
        </div>
        <button type="button" class="btn-secondary btn-sm mt-3" @click="addDistractor">+ Add distractor</button>
      <% } else if (t === 'ordering') { %>
        <p class="mt-1 text-sm muted">Enter the items in the <strong>correct</strong> order. Candidates see them shuffled.</p>
        <ol class="mt-4 space-y-2">
          <template x-for="(it, i) in m.items" :key="it.uid">
            <li class="flex items-center gap-2"><span class="grid h-7 w-7 shrink-0 place-items-center rounded-full bg-slate-100 text-xs font-bold dark:bg-slate-800" x-text="i + 1"></span>
              <input class="input" x-model="it.text" placeholder="Item" maxlength="500" :aria-label="'Item ' + (i + 1)">
              <button type="button" class="btn-ghost btn-sm px-2" @click="move('items', i, -1)" :disabled="i === 0" aria-label="Move up">↑</button>
              <button type="button" class="btn-ghost btn-sm px-2" @click="move('items', i, 1)" :disabled="i === m.items.length - 1" aria-label="Move down">↓</button>
              <button type="button" class="btn-ghost btn-sm px-2 text-red-600" @click="remove('items', i)" :disabled="m.items.length <= 2" aria-label="Remove item">✕</button></li>
          </template>
        </ol>
        <button type="button" class="btn-secondary btn-sm mt-3" @click="addItem" :disabled="m.items.length >= 12">+ Add item</button>
      <% } else if (t === 'hotspot') { %>
        <p class="mt-1 text-sm muted">Upload an image, then drag on it to draw each region. Give every region a label and mark the correct one.</p>
        <div class="mt-4">
          <label class="btn-secondary btn-sm cursor-pointer"><span x-text="m.image ? 'Replace image' : 'Upload image'">Upload image</span><input type="file" accept="image/png,image/jpeg,image/webp" class="sr-only" @change="uploadHotspot"></label>
          <span class="ml-2 text-xs muted" x-show="uploading" x-cloak>Uploading…</span>
        </div>
        <div class="relative mt-4 touch-none select-none overflow-hidden rounded-xl border border-slate-200 dark:border-slate-700" x-show="m.image" x-cloak x-ref="hsWrap" @pointerdown="hsStart" @pointermove="hsMove" @pointerup="hsEnd" @pointerleave="hsEnd">
          <img :src="m.image ? '/qmedia/' + (m.image) : ''" alt="Hotspot image" class="pointer-events-none block w-full" draggable="false">
          <template x-for="(r, i) in m.regions" :key="r.uid">
            <div class="absolute rounded-md border-2" :class="r.correct ? 'border-emerald-500 bg-emerald-500/20' : 'border-primary-500 bg-primary-500/15'" :style="box(r)">
              <span class="m-0.5 inline-block rounded bg-white/90 px-1 text-[0.7rem] font-semibold text-slate-900" x-text="r.label || 'Region ' + (i + 1)"></span>
            </div>
          </template>
          <div class="absolute rounded-md border-2 border-dashed border-amber-500 bg-amber-400/20" x-show="draft" :style="draft ? box(draft) : ''"></div>
        </div>
        <div class="mt-4 space-y-2">
          <template x-for="(r, i) in m.regions" :key="r.uid">
            <div class="flex items-center gap-2">
              <label class="flex items-center gap-1.5 text-xs"><input type="radio" name="hs_correct" class="checkbox rounded-full" :checked="r.correct" @change="setRegionCorrect(i)"> Correct</label>
              <input class="input" x-model="r.label" maxlength="200" placeholder="Label shown to candidates" :aria-label="'Label for region ' + (i + 1)">
              <button type="button" class="btn-ghost btn-sm px-2 text-red-600" @click="remove('regions', i)" aria-label="Remove region">✕</button>
            </div>
          </template>
        </div>
      <% } else if (t === 'short_answer') { %>
        <p class="mt-1 text-sm muted">The answer earns the weight of every keyword it contains (alternatives separated by |). Reaching the threshold earns full marks; below it, the weights found count, capped at the marks. Admins can override marks after grading.</p>
        <div class="mt-4 space-y-2">
          <template x-for="(k, i) in m.keywords" :key="k.uid">
            <div class="grid grid-cols-[1fr_6rem_auto] items-center gap-2">
              <input class="input" x-model="k.text" placeholder="keyword | synonym" :aria-label="'Keyword ' + (i + 1)">
              <input type="number" step="0.5" min="0.5" class="input" x-model="k.weight" :aria-label="'Weight of keyword ' + (i + 1)">
              <button type="button" class="btn-ghost btn-sm px-2 text-red-600" @click="remove('keywords', i)" :disabled="m.keywords.length <= 1" aria-label="Remove keyword">✕</button>
            </div>
          </template>
        </div>
        <button type="button" class="btn-secondary btn-sm mt-3" @click="addKeyword">+ Add keyword</button>
        <div class="mt-4 flex flex-wrap items-end gap-6">
          <div><label class="label" for="sa-th">Score for full marks</label><input id="sa-th" type="number" step="0.5" min="0.5" class="input w-32" x-model="m.threshold"><p class="hint">Total weight: <span x-text="keywordTotal()"></span></p></div>
          <label class="flex items-center gap-2 pb-2 text-sm"><input type="checkbox" class="checkbox" x-model="m.case_sensitive"> Case-sensitive</label>
        </div>
      <% } else if (t === 'essay') { %>
        <div class="mt-4 grid gap-4 sm:grid-cols-2">
          <div><label class="label" for="es-min">Minimum words</label><input id="es-min" type="number" min="0" class="input" x-model="m.min_words" placeholder="none"></div>
          <div><label class="label" for="es-max">Maximum words</label><input id="es-max" type="number" min="1" class="input" x-model="m.max_words" placeholder="none"></div>
        </div>
        <div class="mt-5"><%- include('_rich', { name: 'rubric_html', label: 'Marking guide for graders (never shown to candidates)', value: authoring.rubric_html }) %></div>
      <% } %>
    </section>
    <% } %>

    <section class="card card-body space-y-5">
      <%- include('_rich', { name: 'explanation_html', label: 'Explanation (shown in review)', value: authoring.explanation_html, hint: 'Explain why the answer is correct and why the distractors are wrong.' }) %>
      <%- include('../../partials/field', { name: 'reference', label: 'Reference (book, standard or URL)', value: authoring.reference, maxlength: 500, placeholder: 'e.g. PMBOK Guide 7th ed., §2.4 — or https://docs…' }) %>
    </section>
  </div>

  <aside class="space-y-6">
    <section class="card card-body space-y-4">
      <h2 class="h3">Classification</h2>
      <% if (authorRestricted) { %><p class="text-xs muted">Only your assigned categories are listed.</p><% } %>
      <%- include('../../partials/field', { name: 'category_id', label: 'Category', type: 'select', required: true, value: meta.category_id || '', options: [{ value: '', label: 'Choose…' }].concat(categories.map(function (c) { return { value: c.id, label: c.path }; })) }) %>
      <% if (errorMap.category_id) { %><% } %>
      <div>
        <label class="label" for="f-cert">Certification</label>
        <select id="f-cert" name="certification_id" class="input" x-model="certId" @change="domainId = ''">
          <option value="">— None —</option>
          <template x-for="c in certs" :key="c.id"><option :value="c.id" x-text="(c.code ? c.code + ' · ' : '') + c.name" :selected="isCert(c)"></option></template>
        </select>
      </div>
      <div>
        <label class="label" for="f-dom">Domain / objective</label>
        <select id="f-dom" name="domain_id" class="input" x-model="domainId" :disabled="!domains().length">
          <option value="" x-text="domains().length ? '— None —' : 'Choose a certification first'"></option>
          <template x-for="d in domains()" :key="d.id"><option :value="d.id" x-text="d.label" :selected="isDomain(d)"></option></template>
        </select>
        <% if (errorMap.domain_id) { %><p class="field-error"><%= errorMap.domain_id %></p><% } %>
      </div>
      <%- include('../../partials/field', { name: 'topic', label: 'Topic', value: meta.topic, maxlength: 150, placeholder: 'e.g. Joins' }) %>
      <fieldset>
        <legend class="label">Difficulty</legend>
        <div class="grid grid-cols-5 gap-1">
          <% [1,2,3,4,5].forEach(function (d) { %>
          <label class="cursor-pointer"><input type="radio" name="difficulty" value="<%= d %>" class="peer sr-only" <%= Number(meta.difficulty) === d ? 'checked' : '' %>>
            <span class="block rounded-lg border border-slate-200 py-2 text-center text-sm font-semibold peer-checked:border-primary-600 peer-checked:bg-primary-600 peer-checked:text-on-primary peer-focus-visible:ring-2 peer-focus-visible:ring-primary-500 dark:border-slate-700" title="<%= ['Very easy','Easy','Medium','Hard','Very hard'][d-1] %>"><%= d %></span></label>
          <% }) %>
        </div>
        <p class="hint">1 = very easy · 5 = very hard</p>
      </fieldset>
      <%- include('../../partials/field', { name: 'bloom_level', label: 'Bloom’s level', type: 'select', value: meta.bloom_level || '', options: [{ value: '', label: '— Not set —' }].concat(BLOOM.map(function (b) { return { value: b, label: b.charAt(0).toUpperCase() + b.slice(1) }; })) }) %>
      <div class="grid grid-cols-2 gap-3">
        <% if (t !== 'case_study') { %><%- include('../../partials/field', { name: 'marks', label: 'Marks', type: 'number', value: authoring.marks, min: 0.5, max: 1000, step: 0.5 }) %><% } %>
        <%- include('../../partials/field', { name: 'est_time_sec', label: 'Time (seconds)', type: 'number', value: meta.est_time_sec, min: 5, max: 7200 }) %>
      </div>
      <%- include('../../partials/field', { name: 'tags', label: 'Tags', value: (tags || []).join(', '), placeholder: 'joins, sql, performance', hint: 'Separate with commas.' }) %>
    </section>

    <section class="card card-body space-y-3 lg:sticky lg:top-20">
      <% if (!isNew) { %><%- include('../../partials/field', { name: 'change_note', label: 'What changed? (optional)', maxlength: 500, placeholder: 'e.g. Fixed option C wording' }) %><% } %>
      <% if (isNew || question.status === 'draft') { %>
        <button type="submit" name="save_action" value="draft" class="btn-secondary w-full">Save draft</button>
        <% if (canPublish) { %><button type="submit" name="save_action" value="publish" class="btn-primary w-full">Save &amp; publish</button>
        <% } else { %><button type="submit" name="save_action" value="submit" class="btn-primary w-full">Save &amp; send for review</button><% } %>
        <% if (isNew) { %><button type="submit" name="save_action" value="save_new" class="btn-ghost w-full">Save draft &amp; add another</button><% } %>
      <% } else { %>
        <button type="submit" name="save_action" value="save" class="btn-primary w-full">Save changes</button>
        <p class="text-xs muted">Status stays “<%= question.status.replace('_', ' ') %>”.</p>
      <% } %>
    </section>
  </aside>
</form>
<script src="/vendor/katex/katex.min.js"></script><script src="/vendor/katex/auto-render.min.js"></script>
