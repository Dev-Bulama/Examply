<h1 class="h1 mb-6"><%= t.name %></h1>
<div class="grid gap-6 lg:grid-cols-2">
  <form method="post" action="/admin/email-templates/<%= t.key %>" class="card card-body space-y-5" novalidate>
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <%- include('../../partials/field', { name: 'subject', label: 'Subject', value: t.subject, required: true, maxlength: 255 }) %>
    <%- include('../../partials/field', { name: 'body_html', label: 'Body (HTML)', type: 'textarea', rows: 14, value: t.body_html, required: true }) %>
    <div>
      <p class="label">Variables you can use</p>
      <div class="mt-2 flex flex-wrap gap-1.5"><% ['site_name', 'site_url'].concat(variables).forEach(function (v) { %><code class="rounded bg-slate-100 px-1.5 py-0.5 text-xs dark:bg-slate-800">{{<%= v %>}}</code><% }) %></div>
    </div>
    <div class="flex flex-wrap gap-2"><button class="btn-primary">Save template</button><a class="btn-secondary" href="/admin/email-templates">Back</a></div>
  </form>
  <section class="card">
    <div class="card-body pb-2"><h2 class="h2">Preview</h2><p class="text-sm muted">With sample values. Save to refresh.</p></div>
    <% if (preview) { %>
      <p class="px-6 text-sm"><span class="muted">Subject:</span> <strong><%= preview.subject %></strong></p>
      <iframe title="Email preview" class="mt-3 h-[32rem] w-full rounded-b-xl border-t border-slate-200 bg-white dark:border-slate-800" sandbox srcdoc="<%= preview.html %>"></iframe>
    <% } else { %><p class="card-body text-sm muted">Preview unavailable.</p><% } %>
  </section>
</div>
<% if (hasDefault) { %><form method="post" action="/admin/email-templates/<%= t.key %>" class="mt-4" data-confirm="Replace your edits with the original wording?"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="reset" value="1"><button class="btn-ghost">Reset to the default wording</button></form><% } %>
