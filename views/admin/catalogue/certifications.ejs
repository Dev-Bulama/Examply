<div class="mb-6 flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
  <div>
    <h1 class="h1">Certifications</h1>
    <p class="mt-1 muted">Professional exams you prepare candidates for, with their official format and weighted domains.</p>
  </div>
  <a href="/admin/catalogue/certifications/new" class="btn-primary"><%- include('../../partials/icon', { name: 'plus', cls: 'h-4 w-4' }) %> New certification</a>
</div>
<% if (!certs.length) { %>
  <div class="card flex flex-col items-center px-6 py-16 text-center">
    <span class="grid h-12 w-12 place-items-center rounded-full bg-slate-100 text-slate-500 dark:bg-slate-800"><%- include('../../partials/icon', { name: 'academic' }) %></span>
    <p class="mt-4 font-semibold">No certifications yet</p>
    <p class="mt-1 max-w-md text-sm muted">Add exams such as Oracle 1Z0-082 or AWS Cloud Practitioner. Questions and blueprints use their domains.</p>
    <a href="/admin/catalogue/certifications/new" class="btn-primary mt-4">Add a certification</a>
  </div>
<% } else { %>
<div class="grid gap-4 md:grid-cols-2 xl:grid-cols-3">
  <% certs.forEach(function (c) { %>
  <article class="card flex flex-col">
    <div class="card-body flex-1">
      <div class="flex items-start justify-between gap-3">
        <div>
          <% if (c.exam_code) { %><p class="font-mono text-xs font-semibold text-primary-700 dark:text-primary-300"><%= c.exam_code %></p><% } %>
          <h2 class="h3 mt-0.5"><%= c.name %></h2>
          <p class="text-xs muted"><%= c.issuing_body || '—' %> · <%= c.category_name %></p>
        </div>
        <span class="<%= c.is_active ? 'badge-green' : 'badge-gray' %>"><%= c.is_active ? 'Active' : 'Hidden' %></span>
      </div>
      <dl class="mt-4 grid grid-cols-3 gap-2 text-center text-xs">
        <div class="rounded-lg bg-slate-50 p-2 dark:bg-slate-800/60"><dt class="muted">Pass</dt><dd class="mt-0.5 font-semibold"><%= c.official_passing_score !== null ? `${Number(c.official_passing_score)}${c.official_score_scale === '%' ? '%' : ''}` : '—' %></dd></div>
        <div class="rounded-lg bg-slate-50 p-2 dark:bg-slate-800/60"><dt class="muted">Duration</dt><dd class="mt-0.5 font-semibold"><%= c.official_duration_minutes ? `${c.official_duration_minutes} min` : '—' %></dd></div>
        <div class="rounded-lg bg-slate-50 p-2 dark:bg-slate-800/60"><dt class="muted">Questions</dt><dd class="mt-0.5 font-semibold"><%= c.official_question_count || '—' %></dd></div>
      </dl>
      <p class="mt-4 text-sm">
        <strong><%= c.domain_count %></strong> domain<%= c.domain_count === 1 ? '' : 's' %>
        <% if (c.domain_count) { %><span class="<%= c.weight_total === 100 ? 'badge-green' : 'badge-amber' %> ml-1"><%= c.weight_total %>%</span><% } %>
        · <a class="link" href="/admin/questions?certification=<%= c.id %>"><%= c.questions %> question<%= c.questions === 1 ? '' : 's' %></a> <span class="muted">(<%= c.published %> published)</span>
      </p>
    </div>
    <div class="flex justify-end gap-2 border-t border-slate-200 px-5 py-3 dark:border-slate-800">
      <form method="post" action="/admin/catalogue/certifications/<%= c.id %>/delete" data-confirm="Delete “<%= c.name %>”?" data-confirm-label="Delete"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn-ghost btn-sm text-red-600" type="submit">Delete</button></form>
      <a href="/admin/catalogue/certifications/<%= c.id %>/edit" class="btn-secondary btn-sm">Edit</a>
    </div>
  </article>
  <% }) %>
</div>
<% } %>
