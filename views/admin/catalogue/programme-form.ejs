<div class="mx-auto max-w-4xl">
  <h1 class="h1"><%= programme.id ? `Edit ${programme.name}` : 'New training programme' %></h1>
  <form method="post" action="<%= programme.id ? `/admin/catalogue/programmes/${programme.id}` : '/admin/catalogue/programmes' %>" class="mt-6 space-y-6" novalidate>
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <section class="card card-body grid gap-5 sm:grid-cols-2">
      <%- include('../../partials/field', { name: 'name', label: 'Name', value: programme.name, required: true, maxlength: 180 }) %>
      <%- include('../../partials/field', { name: 'category_id', label: 'Category', type: 'select', value: programme.category_id || '', options: [{ value: '', label: '— None —' }].concat(categories.map(function (c) { return { value: c.id, label: c.path }; })) }) %>
      <%- include('../../partials/field', { name: 'description', label: 'Description', type: 'textarea', rows: 3, value: programme.description, maxlength: 5000, wrapperClass: 'sm:col-span-2' }) %>
      <%- include('../../partials/field', { name: 'levels', label: 'Levels / modules (one per line)', type: 'textarea', rows: 4, value: levelsText, maxlength: 2000, hint: 'Optional. For example: Foundations, Administration, Performance Tuning.' }) %>
      <div class="flex items-end"><%- include('../../partials/field', { name: 'is_active', label: 'Active', type: 'checkbox', value: programme.is_active }) %></div>
    </section>
    <section class="card card-body">
      <h2 class="h2">Recommendation per proficiency band</h2>
      <p class="mt-1 text-sm muted">Shown on diagnostic results. Exams can override these per band.</p>
      <div class="mt-5 grid gap-4 md:grid-cols-2">
        <% bandRows.forEach(function (b, i) { const ob = (old.bands && old.bands[b.band]) || {}; %>
        <fieldset class="rounded-lg border border-slate-200 p-4 dark:border-slate-700">
          <legend class="px-1 text-sm font-semibold"><%= b.band %></legend>
          <div class="space-y-3">
            <div><label class="label" for="bt-<%= i %>">Course title</label><input id="bt-<%= i %>" class="input" name="bands[<%= b.band %>][course_title]" value="<%= ob.course_title !== undefined ? ob.course_title : (b.course_title || '') %>" maxlength="200"></div>
            <div><label class="label" for="bu-<%= i %>">Course URL</label><input id="bu-<%= i %>" type="url" class="input <%= errors[`bands.${b.band}.course_url`] ? 'input-error' : '' %>" name="bands[<%= b.band %>][course_url]" value="<%= ob.course_url !== undefined ? ob.course_url : (b.course_url || '') %>" placeholder="https://"><% if (errors[`bands.${b.band}.course_url`]) { %><p class="field-error"><%= errors[`bands.${b.band}.course_url`] %></p><% } %></div>
            <div><label class="label" for="bm-<%= i %>">Message to the candidate</label><textarea id="bm-<%= i %>" class="input" rows="2" name="bands[<%= b.band %>][message]" maxlength="2000"><%= ob.message !== undefined ? ob.message : (b.message || '') %></textarea></div>
          </div>
        </fieldset>
        <% }) %>
      </div>
    </section>
    <div class="flex justify-end gap-3">
      <a href="/admin/catalogue/programmes" class="btn-secondary">Cancel</a>
      <button type="submit" class="btn-primary" data-loading-text="Saving…">Save programme</button>
    </div>
  </form>
</div>
