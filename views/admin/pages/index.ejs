<div class="mb-6"><h1 class="h1">Pages &amp; FAQ</h1><p class="mt-1 muted">Your own pages (terms, privacy, about…) and the help centre questions.</p></div>
<div class="grid gap-6 lg:grid-cols-2">
  <section class="card">
    <div class="card-body flex items-center justify-between pb-2"><h2 class="h2">Pages</h2><a class="btn-primary btn-sm" href="/admin/pages/new">New page</a></div>
    <ul class="divide-y divide-slate-100 dark:divide-slate-800">
      <% pages.forEach(function (p) { %>
      <li class="flex items-center justify-between gap-3 px-6 py-3"><span class="min-w-0"><a class="link font-medium" href="/admin/pages/<%= p.id %>/edit"><%= p.title %></a><span class="block text-xs muted">/p/<%= p.slug %><%= p.show_in_footer ? ' · in footer' : '' %></span></span><span class="flex items-center gap-2"><span class="<%= p.is_published ? 'badge-green' : 'badge-gray' %>"><%= p.is_published ? 'Published' : 'Draft' %></span><% if (p.is_published) { %><a class="btn-ghost btn-sm" href="/p/<%= p.slug %>" target="_blank" rel="noopener">View</a><% } %></span></li>
      <% }) %>
      <% if (!pages.length) { %><li class="px-6 py-3 text-sm muted">No pages yet.</li><% } %>
    </ul>
  </section>
  <section class="card">
    <div class="card-body flex items-center justify-between pb-2"><h2 class="h2">Help centre FAQ</h2><a class="btn-primary btn-sm" href="/admin/faqs/new">New question</a></div>
    <ul class="divide-y divide-slate-100 dark:divide-slate-800">
      <% faqs.forEach(function (f) { %>
      <li class="flex items-center justify-between gap-3 px-6 py-3"><span class="min-w-0"><a class="link font-medium" href="/admin/faqs/<%= f.id %>/edit"><%= f.question %></a><span class="block text-xs muted"><%= f.category || 'General' %></span></span><span class="<%= f.is_published ? 'badge-green' : 'badge-gray' %>"><%= f.is_published ? 'Shown' : 'Hidden' %></span></li>
      <% }) %>
      <% if (!faqs.length) { %><li class="px-6 py-3 text-sm muted">No questions yet.</li><% } %>
    </ul>
  </section>
</div>
