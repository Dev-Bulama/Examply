<div class="mb-6 flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between">
  <div><span class="<%= ORDER_STATUS[o.status][0] %>"><%= ORDER_STATUS[o.status][1] %></span><h1 class="h1 mt-2">Order <span class="font-mono"><%= o.order_no %></span></h1><p class="mt-1 muted"><%= o.full_name %> · <%= o.email %> · <%= fmt.dateTime(o.created_at) %></p></div>
  <a class="btn-secondary" href="/admin/orders/<%= o.id %>/invoice">Invoice PDF</a>
</div>
<div class="grid gap-6 lg:grid-cols-[minmax(0,1fr)_22rem]">
  <div class="space-y-6">
    <section class="card card-body">
      <h2 class="h2">Items</h2>
      <table class="mt-3 w-full text-sm"><tbody>
        <% o.items.forEach(function (i) { %><tr class="border-b border-slate-100 dark:border-slate-800"><td class="py-2"><%= i.name %><%= i.quantity > 1 ? ' × ' + i.quantity : '' %></td><td class="py-2 text-right"><%= fmt.money(i.total_kobo, o.currency) %></td></tr><% }) %>
        <% if (o.discount_kobo) { %><tr><td class="py-2">Coupon <%= o.coupon_code %></td><td class="py-2 text-right">− <%= fmt.money(o.discount_kobo, o.currency) %></td></tr><% } %>
        <tr class="font-semibold"><td class="py-2">Total</td><td class="py-2 text-right"><%= fmt.money(o.total_kobo, o.currency) %></td></tr>
      </tbody></table>
      <% if (o.buyer_note) { %><p class="mt-3 text-sm muted">Note: <%= o.buyer_note %></p><% } %>
    </section>
    <% if (o.payment_method === 'bank_transfer') { %>
    <section class="card card-body">
      <h2 class="h2">Bank transfer</h2>
      <% if (!o.transfer_submitted_at && o.status === 'awaiting_transfer') { %><p class="mt-2 text-sm muted">Waiting for the candidate to transfer and upload a receipt<%= o.expires_at ? ' (held until ' + fmt.dateTime(o.expires_at) + ')' : '' %>.</p><% } %>
      <% if (o.transfer_submitted_at) { %>
        <dl class="mt-3 grid gap-2 text-sm sm:grid-cols-2"><div><dt class="muted">Submitted</dt><dd><%= fmt.dateTime(o.transfer_submitted_at) %></dd></div><div><dt class="muted">Reference</dt><dd class="font-mono"><%= o.transfer_reference || '—' %></dd></div><% if (o.transfer_note) { %><div class="sm:col-span-2"><dt class="muted">Note</dt><dd><%= o.transfer_note %></dd></div><% } %></dl>
        <% if (o.transfer_proof_path) { %><% if (/\.pdf$/.test(o.transfer_proof_path)) { %><a class="btn-secondary btn-sm mt-3" href="/admin/orders/<%= o.id %>/proof" target="_blank" rel="noopener">Open receipt (PDF)</a><% } else { %><a href="/admin/orders/<%= o.id %>/proof" target="_blank" rel="noopener"><img src="/admin/orders/<%= o.id %>/proof" alt="Transfer receipt" class="mt-3 max-h-96 rounded-lg border border-slate-200 dark:border-slate-700"></a><% } %><% } %>
      <% } %>
      <% if (o.reviewed_at) { %><p class="mt-3 text-sm muted">Reviewed <%= fmt.dateTime(o.reviewed_at) %><%= o.review_note ? ': ' + o.review_note : '' %></p><% } %>
      <% if (o.status === 'awaiting_transfer' && can('orders.manage')) { %>
      <div class="mt-5 grid gap-4 md:grid-cols-2">
        <form method="post" action="/admin/orders/<%= o.id %>/approve" class="space-y-2" data-confirm="Confirm you received <%= fmt.money(o.total_kobo, o.currency) %> for <%= o.order_no %>? Access is granted immediately." data-confirm-label="Confirm payment"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label class="label" for="an">Note (optional)</label><input id="an" name="note" class="input" maxlength="500" placeholder="e.g. Seen on GTB statement 24 Nov"><button class="btn-primary">Confirm payment received</button></form>
        <form method="post" action="/admin/orders/<%= o.id %>/reject" class="space-y-2"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label class="label" for="rn">Ask for a new receipt</label><input id="rn" name="note" class="input" maxlength="500" placeholder="e.g. Amount does not match — please check"><button class="btn-secondary">Send back to candidate</button></form>
      </div>
      <% } %>
    </section>
    <% } %>
    <section class="card card-body">
      <h2 class="h2">Payments &amp; webhooks</h2>
      <% if (!o.payments.length) { %><p class="mt-2 text-sm muted">No payment records.</p><% } %>
      <ul class="mt-3 space-y-2 text-sm"><% o.payments.forEach(function (p) { %><li class="flex flex-wrap justify-between gap-2 rounded-lg bg-slate-50 px-3 py-2 dark:bg-slate-800/60"><span class="font-mono"><%= p.reference %></span><span><%= p.provider %><%= p.channel ? ' · ' + p.channel : '' %> · <%= fmt.money(p.amount_kobo, p.currency) %> · <strong><%= p.status %></strong></span></li><% }) %></ul>
      <% if (webhooks.length) { %><ul class="mt-3 space-y-1 text-xs muted"><% webhooks.forEach(function (w) { %><li><%= fmt.dateTime(w.created_at) %> · <%= w.event %> · <%= w.outcome %><%= w.signature_valid ? '' : ' (bad signature)' %></li><% }) %></ul><% } %>
    </section>
  </div>
  <aside class="space-y-4">
    <section class="card card-body text-sm">
      <h2 class="h3">Access granted</h2>
      <% if (!entitlements.length && !subs.length) { %><p class="mt-2 muted"><%= o.status === 'paid' ? 'Extra attempts are listed on the exam’s Attempts tab.' : 'Nothing until payment is confirmed.' %></p><% } %>
      <ul class="mt-2 space-y-2"><% entitlements.forEach(function (e) { %><li><%= e.name %><span class="block text-xs muted"><%= e.revoked_at ? 'Revoked — ' + e.revoke_reason : e.expires_at ? 'until ' + fmt.date(e.expires_at) : 'lifetime' %></span></li><% }) %>
      <% subs.forEach(function (s) { %><li>Subscription <span class="badge-gray"><%= s.status %></span><span class="block text-xs muted">until <%= fmt.date(s.current_period_end) %></span></li><% }) %></ul>
    </section>
    <% if (o.status === 'paid' && can('orders.manage') && o.payment_method !== 'free') { %>
    <form method="post" action="/admin/orders/<%= o.id %>/refund" class="card card-body space-y-2" data-confirm="Refund this order? Access is removed immediately. Return the money separately in Paystack or by transfer." data-confirm-label="Refund">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>"><h2 class="h3">Refund</h2><label class="label" for="rr">Reason</label><input id="rr" name="reason" class="input" maxlength="500" required><button class="btn-danger">Refund and remove access</button>
    </form>
    <% } %>
  </aside>
</div>
