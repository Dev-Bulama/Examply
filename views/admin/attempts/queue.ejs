<div class="mb-6"><h1 class="h1">Grading queue</h1><p class="mt-1 muted">Answers that need a person — essays, and any automatic mark that was sent for review. Oldest first.</p></div>
<% if (!pager.rows.length) { %>
  <div class="card card-body flex flex-col items-center py-16 text-center"><span class="grid h-12 w-12 place-items-center rounded-full bg-emerald-50 text-emerald-600 dark:bg-emerald-950/40"><%- include('../../partials/icon', { name: 'check' }) %></span><p class="mt-4 font-semibold">Nothing to grade</p><p class="mt-1 text-sm muted">New essay answers appear here as soon as candidates submit.</p></div>
<% } else { %>
<div class="space-y-4">
  <% pager.rows.forEach(function (r) { const resp = r.response || {}; %>
  <section class="card">
    <div class="card-body">
      <div class="flex flex-wrap items-center justify-between gap-2 text-sm"><span><span class="font-semibold"><%= r.full_name %></span> <span class="muted">· <%= r.title %> · submitted <%= fmt.relative(r.submitted_at) %></span></span><a class="link" href="/admin/attempts/<%= r.attempt_id %>#item-<%= r.id %>">Open attempt</a></div>
      <div class="q-content prose-content mt-3 max-w-none"><%- r.stem_html %></div>
      <div class="mt-4 grid gap-4 lg:grid-cols-2">
        <div class="rounded-lg border border-slate-200 p-3 text-sm dark:border-slate-700"><p class="mb-2 text-xs font-semibold uppercase tracking-wide muted">Answer<% if (r.settings.min_words || r.settings.max_words) { %> · <%= String(resp.text || '').trim().split(/\s+/).filter(Boolean).length %> words<% } %></p><p class="whitespace-pre-line"><%= resp.text || resp.sql || '(no answer)' %></p></div>
        <div class="rounded-lg border border-primary-200 bg-primary-50/50 p-3 text-sm dark:border-primary-900 dark:bg-primary-950/20"><p class="mb-2 text-xs font-semibold uppercase tracking-wide muted">Marking guide</p><div class="prose-content max-w-none"><%- r.answer.rubric_html || '<p class="muted">No guide.</p>' %></div></div>
      </div>
      <form method="post" action="/admin/attempts/<%= r.attempt_id %>/items/<%= r.id %>/grade" class="mt-4 flex flex-wrap items-end gap-2">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="back" value="/admin/grading">
        <div><label class="label" for="m<%= r.id %>">Marks (of <%= Number(r.marks_possible) %>)</label><input id="m<%= r.id %>" name="marks" type="number" step="0.25" min="0" max="<%= Number(r.marks_possible) %>" class="input w-28" required></div>
        <div class="min-w-[14rem] flex-1"><label class="label" for="f<%= r.id %>">Feedback to the candidate</label><input id="f<%= r.id %>" name="feedback" class="input" maxlength="5000"></div>
        <button class="btn-primary">Save grade</button>
      </form>
    </div>
  </section>
  <% }) %>
</div>
<div class="mt-4"><%- include('../../partials/pagination', { pager: pager, basePath: '/admin/grading', query: query }) %></div>
<% } %>
