<% const show = function (v) { return v === undefined ? '—' : typeof v === 'object' ? JSON.stringify(v, null, 2) : String(v); }; %>
<div class="mb-6">
  <h1 class="h1">Audit entry #<%= row.id %></h1>
  <p class="mt-1 muted"><code><%= row.action %></code> by <%= row.full_name || 'System' %> on <%= fmt.dateTime(row.created_at) %></p>
</div>
<div class="grid gap-6 lg:grid-cols-3">
  <section class="card lg:col-span-2">
    <div class="card-body"><h2 class="h2">Changes</h2></div>
    <% if (!diff.length) { %><p class="px-6 pb-6 text-sm muted">This action recorded no field values.</p><% } else { %>
    <div class="overflow-x-auto p-2 sm:p-0">
      <table class="table table-responsive">
        <thead><tr><th>Field</th><th>Before</th><th>After</th></tr></thead>
        <tbody>
          <% diff.forEach(function (d) { %>
          <tr class="<%= d.changed ? 'bg-amber-50/60 dark:bg-amber-950/20' : '' %>">
            <td data-label="Field"><code class="text-xs"><%= d.key %></code></td>
            <td data-label="Before"><pre class="whitespace-pre-wrap break-all text-xs"><%= show(d.before) %></pre></td>
            <td data-label="After"><pre class="whitespace-pre-wrap break-all text-xs"><%= show(d.after) %></pre></td>
          </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
    <% } %>
  </section>
  <section class="card card-body text-sm">
    <h2 class="h3">Context</h2>
    <dl class="mt-3 space-y-2">
      <div><dt class="muted">Staff member</dt><dd><%= row.full_name || 'System' %> <% if (row.email) { %><span class="muted">(<%= row.email %>)</span><% } %></dd></div>
      <div><dt class="muted">Entity</dt><dd><%= row.entity_type ? `${row.entity_type} #${row.entity_id}` : '—' %></dd></div>
      <div><dt class="muted">IP address</dt><dd class="font-mono"><%= row.ip || '—' %></dd></div>
      <div><dt class="muted">Browser</dt><dd class="break-all text-xs"><%= row.user_agent || '—' %></dd></div>
    </dl>
  </section>
</div>
<p class="mt-6"><a href="/admin/audit" class="link">← Back to the audit log</a></p>
