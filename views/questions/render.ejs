<%
/*
 * Renders a question exactly as a candidate sees it, from a candidateView() object (no answers inside).
 * Locals: view, name (input name prefix), number (display number), interactive (bool), response (optional prior answer)
 */
const v = view;
const nm = locals.name || 'q';
const resp = locals.response || {};
const L = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ';
const disabled = locals.interactive === false ? 'disabled' : '';
const stemHtml = v.type === 'fill_blank'
  ? v.stem_html.replace(/\[\[(\d{1,2})\]\]/g, function (m, n) {
      const val = (resp.blanks || [])[Number(n) - 1] || '';
      return `<label class="sr-only" for="${nm}-b${n}">Blank ${n}</label><input id="${nm}-b${n}" name="${nm}[blanks][${Number(n) - 1}]" value="${String(val).replace(/"/g, '&quot;')}" class="q-blank mx-1 inline-block w-36 rounded-md border-slate-300 px-2 py-1 align-baseline text-sm focus:border-primary-500 focus:ring-primary-500 dark:border-slate-600 dark:bg-slate-900" autocomplete="off" spellcheck="false" ${disabled}>`;
    })
  : v.stem_html;
%>
<div class="q-render" data-type="<%= v.type %>">
  <div class="q-content prose-content max-w-none text-base leading-relaxed sm:text-[1.05rem]"><%- stemHtml %></div>

  <% if (['single_choice', 'true_false', 'multiple_response'].includes(v.type)) { const multi = v.type === 'multiple_response'; %>
    <% if (multi) { %><p class="mt-4 text-sm font-medium text-primary-700 dark:text-primary-300"><%= v.settings.select_exact ? `Select exactly ${v.settings.select_exact}.` : 'Select all that apply.' %></p><% } %>
    <fieldset class="mt-4 space-y-2.5">
      <legend class="sr-only">Answer options</legend>
      <% v.options.forEach(function (o, i) { const checked = (resp.selected || []).includes(o.key); %>
      <label class="group flex cursor-pointer items-start gap-3 rounded-xl border border-slate-200 bg-white p-3.5 transition hover:border-primary-300 hover:bg-primary-50/40 has-[:checked]:border-primary-600 has-[:checked]:bg-primary-50 has-[:checked]:ring-1 has-[:checked]:ring-primary-600 dark:border-slate-700 dark:bg-slate-900 dark:hover:bg-primary-950/30 dark:has-[:checked]:bg-primary-950/50 sm:p-4">
        <input type="<%= multi ? 'checkbox' : 'radio' %>" name="<%= nm %>[selected]<%= multi ? '[]' : '' %>" value="<%= o.key %>" class="peer sr-only" <%= checked ? 'checked' : '' %> <%= disabled %>>
        <span class="grid h-7 w-7 shrink-0 place-items-center rounded-<%= multi ? 'md' : 'full' %> border border-slate-300 text-xs font-bold text-slate-600 group-has-[:checked]:border-primary-600 group-has-[:checked]:bg-primary-600 group-has-[:checked]:text-on-primary peer-focus-visible:ring-2 peer-focus-visible:ring-primary-500 dark:border-slate-600 dark:text-slate-300"><%= v.type === 'true_false' ? (o.key === 'T' ? 'T' : 'F') : L[i] %></span>
        <span class="q-content min-w-0 flex-1 pt-0.5 text-[0.95rem]"><%- o.html %></span>
      </label>
      <% }) %>
    </fieldset>
  <% } else if (v.type === 'fill_blank') { %>
    <p class="mt-3 text-xs muted">Type your answer in each blank.</p>
  <% } else if (v.type === 'numeric') { %>
    <div class="mt-5 flex max-w-xs items-center gap-2">
      <label class="sr-only" for="<%= nm %>-num">Your answer</label>
      <input id="<%= nm %>-num" type="text" inputmode="decimal" name="<%= nm %>[value]" value="<%= resp.value ?? '' %>" class="input text-lg" placeholder="Your answer" autocomplete="off" <%= disabled %>>
      <% if (v.settings.units) { %><span class="text-sm font-medium muted"><%= v.settings.units %></span><% } %>
    </div>
  <% } else if (v.type === 'matching') { %>
    <div class="mt-5 space-y-3">
      <% v.left.forEach(function (l, i) { const sel = (resp.pairs || {})[l.key] || ''; %>
      <div class="grid gap-2 rounded-xl border border-slate-200 p-3 dark:border-slate-700 sm:grid-cols-2 sm:items-center">
        <div class="q-content flex items-start gap-2 text-sm font-medium"><span class="badge-gray shrink-0"><%= i + 1 %></span><span><%- l.html %></span></div>
        <div>
          <label class="sr-only" for="<%= nm %>-m<%= i %>">Match for item <%= i + 1 %></label>
          <select id="<%= nm %>-m<%= i %>" name="<%= nm %>[pairs][<%= l.key %>]" class="input" <%= disabled %>>
            <option value="">Choose a match…</option>
            <% v.right.forEach(function (r) { %><option value="<%= r.key %>" <%= sel === r.key ? 'selected' : '' %>><%= r.html.replace(/<[^>]+>/g, '').replace(/&amp;/g, '&').replace(/&lt;/g, '<').replace(/&gt;/g, '>').replace(/&quot;/g, '"').replace(/&#39;/g, "'") %></option><% }) %>
          </select>
        </div>
      </div>
      <% }) %>
    </div>
  <% } else if (v.type === 'ordering') { %>
    <p class="mt-4 text-sm muted">Put the items in the correct order using the arrows (or drag on larger screens).</p>
    <% const orderItems = (resp.order || []).length ? resp.order.map(function (k) { return v.items.find(function (it) { return it.key === k; }); }).filter(Boolean) : v.items; %>
    <ol class="mt-3 space-y-2" x-data="orderInput">
      <% orderItems.forEach(function (it, i) { %>
      <li class="flex items-center gap-2 rounded-xl border border-slate-200 bg-white p-3 dark:border-slate-700 dark:bg-slate-900" data-order-item draggable="true" @dragstart="drag" @dragover.prevent @drop="drop">
        <span class="grid h-7 w-7 shrink-0 place-items-center rounded-full bg-slate-100 text-xs font-bold dark:bg-slate-800" data-order-pos><%= i + 1 %></span>
        <span class="q-content min-w-0 flex-1 text-sm"><%- it.html %></span>
        <input type="hidden" name="<%= nm %>[order][]" value="<%= it.key %>">
        <button type="button" class="btn-ghost btn-sm px-2" @click="up" data-dir="up" aria-label="Move up" <%= disabled %>>↑</button>
        <button type="button" class="btn-ghost btn-sm px-2" @click="down" data-dir="down" aria-label="Move down" <%= disabled %>>↓</button>
      </li>
      <% }) %>
    </ol>
  <% } else if (v.type === 'hotspot') { %>
    <p class="mt-4 text-sm muted">Select the correct region on the image.</p>
    <fieldset class="relative mt-3 overflow-hidden rounded-xl border border-slate-200 dark:border-slate-700">
      <legend class="sr-only">Regions</legend>
      <img src="/qmedia/<%= v.settings.image %>" alt="Question image" class="block w-full select-none" loading="lazy" draggable="false">
      <% v.regions.forEach(function (r) { const checked = (resp.selected || []).includes(r.key); %>
      <label class="absolute cursor-pointer" style="left:<%= r.region.x %>%;top:<%= r.region.y %>%;width:<%= r.region.w %>%;height:<%= r.region.h %>%">
        <input type="radio" name="<%= nm %>[selected]" value="<%= r.key %>" class="peer sr-only" <%= checked ? 'checked' : '' %> <%= disabled %>>
        <span class="flex h-full w-full items-start justify-start rounded-md border-2 border-dashed border-primary-500/70 bg-primary-500/5 p-1 hover:bg-primary-500/15 peer-checked:border-solid peer-checked:border-primary-600 peer-checked:bg-primary-500/25 peer-focus-visible:ring-2 peer-focus-visible:ring-primary-500">
          <span class="rounded bg-white/90 px-1.5 py-0.5 text-xs font-semibold text-slate-900 shadow dark:bg-slate-900/90 dark:text-slate-100"><%- r.label %></span>
        </span>
      </label>
      <% }) %>
    </fieldset>
  <% } else if (v.type === 'short_answer') { %>
    <div class="mt-5">
      <label class="label" for="<%= nm %>-sa">Your answer</label>
      <textarea id="<%= nm %>-sa" name="<%= nm %>[text]" rows="3" class="input" maxlength="2000" <%= disabled %>><%= resp.text || '' %></textarea>
    </div>
  <% } else if (v.type === 'sql') { %>
    <div class="mt-5 overflow-hidden rounded-xl border border-slate-200 dark:border-slate-700" x-data="sqlLab" data-run="<%= locals.sqlRunUrl || '' %>" data-check="<%= locals.sqlCheck ? '1' : '' %>">
      <div class="flex flex-wrap items-center gap-2 border-b border-slate-200 bg-slate-50 px-3 py-2 dark:border-slate-700 dark:bg-slate-800/60">
        <span class="flex items-center gap-1.5 text-sm font-semibold"><svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M20.25 6.375c0 2.278-3.694 4.125-8.25 4.125S3.75 8.653 3.75 6.375m16.5 0c0-2.278-3.694-4.125-8.25-4.125S3.75 4.097 3.75 6.375m16.5 0v11.25c0 2.278-3.694 4.125-8.25 4.125s-8.25-1.847-8.25-4.125V6.375"/></svg> SQL lab</span>
        <span class="badge-gray"><%= v.settings.mode === 'modify' ? 'Change the data' : 'Write a query' %></span>
        <span class="text-xs muted">SQLite · each run uses a fresh copy of the data</span>
      </div>
      <div class="grid lg:grid-cols-[13rem_minmax(0,1fr)]">
        <div class="border-b border-slate-200 p-3 text-xs dark:border-slate-700 lg:border-b-0 lg:border-r">
          <p class="font-semibold uppercase tracking-wide muted">Tables</p>
          <p class="mt-1 muted" x-show="!tables.length" x-text="schemaNote()">Loading…</p>
          <template x-for="tb in tables" :key="tb.name">
            <details class="mt-2" open><summary class="cursor-pointer font-mono font-semibold" x-text="tb.name"></summary>
              <ul class="ml-3 mt-1 space-y-0.5 font-mono muted"><template x-for="c in tb.columns" :key="c.name"><li><button type="button" class="hover:text-primary-600 hover:underline" @click="insertColumn" :data-col="c.name" x-text="c.name"></button> <span class="opacity-70" x-text="c.type"></span><span x-show="c.pk" title="Primary key"> 🔑</span></li></template></ul></details>
          </template>
          <details class="mt-3"><summary class="cursor-pointer muted">Schema (SQL)</summary><pre class="mt-1 whitespace-pre-wrap font-mono text-[11px]"><%= v.settings.schema_sql %></pre></details>
        </div>
        <div class="min-w-0 p-3">
          <label class="sr-only" for="<%= nm %>-sql">Your SQL</label>
          <textarea id="<%= nm %>-sql" name="<%= nm %>[sql]" rows="7" class="input code-input" spellcheck="false" autocapitalize="off" autocomplete="off" x-ref="editor" @keydown="keys" <%= disabled %>><%= resp.sql !== undefined ? resp.sql : (v.settings.starter_sql || '') %></textarea>
          <div class="mt-2 flex flex-wrap items-center gap-2">
            <button type="button" class="btn-primary btn-sm" @click="run" :disabled="busy" <%= disabled %>>▶ Run <span class="hidden text-xs opacity-75 sm:inline">(Ctrl+Enter)</span></button>
            <button type="button" class="btn-secondary btn-sm" x-show="canCheck()" @click="check" :disabled="busy">Check answer</button>
            <span class="text-xs muted" aria-live="polite" x-text="status()"></span>
          </div>
          <div class="mt-2 rounded-lg p-3 text-sm" x-show="verdict" :class="verdictClass()" x-text="verdict" role="status"></div>
          <pre class="mt-2 whitespace-pre-wrap rounded bg-red-50 p-2 text-xs text-red-700 dark:bg-red-950/40 dark:text-red-300" x-show="error" x-text="error"></pre>
          <div class="mt-2 max-h-72 overflow-auto rounded border border-slate-200 dark:border-slate-700" x-show="cols.length">
            <table class="w-full text-left font-mono text-xs">
              <thead class="sticky top-0 bg-slate-100 dark:bg-slate-800"><tr><template x-for="c in cols" :key="c"><th class="px-2 py-1" x-text="c"></th></template></tr></thead>
              <tbody><template x-for="(r, ri) in rows" :key="ri"><tr class="border-t border-slate-100 dark:border-slate-800"><template x-for="(val, vi) in r" :key="vi"><td class="px-2 py-1" x-text="cell(val)"></td></template></tr></template></tbody>
            </table>
          </div>
          <p class="mt-2 text-xs muted"><%= v.settings.mode === 'modify' ? 'Write the INSERT, UPDATE or DELETE statements that complete the task. Your last submitted SQL is what gets marked.' : 'Write one query that returns the requested result. Your last submitted SQL is what gets marked — run it as often as you like.' %></p>
        </div>
      </div>
    </div>
  <% } else if (v.type === 'lab') { const b = v.settings.brief || { tasks: [] }; %>
    <div class="mt-5 grid gap-4 xl:grid-cols-[minmax(0,1fr)_16rem]">
      <div class="min-w-0 overflow-hidden rounded-xl border border-slate-800 bg-[#0b1020] shadow-pop">
        <div class="flex items-center gap-2 border-b border-slate-800 px-3 py-2 text-xs text-slate-400">
          <span class="h-2.5 w-2.5 rounded-full bg-red-500"></span><span class="h-2.5 w-2.5 rounded-full bg-amber-400"></span><span class="h-2.5 w-2.5 rounded-full bg-emerald-500"></span>
          <span class="ml-2 font-mono"><%= b.user %>@<%= b.hostname %></span>
          <span class="ml-auto" data-lab-status>Connecting…</span>
          <% if (locals.labReset) { %><button type="button" class="whitespace-nowrap rounded px-2 py-0.5 text-slate-300 hover:bg-slate-800" data-lab-reset>Reset</button><% } %>
        </div>
        <div class="lab-terminal h-[26rem] p-2" data-lab-url="<%= locals.labUrl || '' %>" role="application" aria-label="Lab terminal. Type commands and press Enter."></div>
      </div>
      <aside class="rounded-xl border border-slate-200 p-4 text-sm dark:border-slate-700">
        <p class="font-semibold">Tasks</p>
        <ol class="mt-2 space-y-2" data-lab-tasks>
          <% b.tasks.forEach(function (t, i) { %><li class="flex gap-2" data-task="<%= t.id %>"><span class="mt-0.5 grid h-5 w-5 shrink-0 place-items-center rounded-full border border-slate-300 text-[10px] font-bold dark:border-slate-600" data-task-mark><%= i + 1 %></span><span class="flex-1"><%= t.title %> <span class="text-xs muted">(<%= t.marks %>)</span></span></li><% }) %>
        </ol>
        <p class="mt-4 text-xs muted">Work on the machine in the terminal. Everything is checked automatically when you submit. Answers you find (an IP address, a flag): <code>submit &lt;answer&gt;</code></p>
      </aside>
    </div>
    <% if (!locals.labUrl) { %><p class="mt-2 text-sm muted">The terminal is available during the exam.</p><% } %>
  <% } else if (v.type === 'essay') { %>
    <div class="mt-5" x-data="wordCount" data-min="<%= v.settings.min_words || '' %>" data-max="<%= v.settings.max_words || '' %>">
      <label class="label" for="<%= nm %>-es">Your answer</label>
      <textarea id="<%= nm %>-es" name="<%= nm %>[text]" rows="10" class="input" maxlength="30000" @input="count" x-ref="area" <%= disabled %>><%= resp.text || '' %></textarea>
      <p class="mt-1.5 text-xs muted" aria-live="polite"><span x-text="words">0</span> words<% if (v.settings.min_words || v.settings.max_words) { %> · <%= v.settings.min_words ? `minimum ${v.settings.min_words}` : '' %><%= v.settings.min_words && v.settings.max_words ? ', ' : '' %><%= v.settings.max_words ? `maximum ${v.settings.max_words}` : '' %><% } %></p>
    </div>
  <% } %>
</div>
