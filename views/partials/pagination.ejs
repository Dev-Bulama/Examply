<% /* Locals: pager ({page,pages,total,from,to}), basePath, query */ %>
<% if (pager.total > 0) { %>
<nav class="flex flex-col items-center justify-between gap-3 border-t border-slate-200 px-4 py-3 text-sm dark:border-slate-800 sm:flex-row" aria-label="Pagination">
  <p class="muted">Showing <strong class="text-slate-900 dark:text-slate-100"><%= pager.from %>–<%= pager.to %></strong> of <strong class="text-slate-900 dark:text-slate-100"><%= pager.total %></strong></p>
  <% if (pager.pages > 1) { %>
  <div class="flex items-center gap-1">
    <% if (pager.page > 1) { %><a class="btn-secondary btn-sm" href="<%= pageUrl(basePath, query, pager.page - 1) %>" rel="prev">Previous</a><% } else { %><span class="btn-secondary btn-sm pointer-events-none opacity-50" aria-disabled="true">Previous</span><% } %>
    <span class="px-3 muted">Page <%= pager.page %> of <%= pager.pages %></span>
    <% if (pager.page < pager.pages) { %><a class="btn-secondary btn-sm" href="<%= pageUrl(basePath, query, pager.page + 1) %>" rel="next">Next</a><% } else { %><span class="btn-secondary btn-sm pointer-events-none opacity-50" aria-disabled="true">Next</span><% } %>
  </div>
  <% } %>
</nav>
<% } %>
