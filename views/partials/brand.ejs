<a href="/" class="flex items-center gap-2.5 font-semibold tracking-tight <%= locals.cls || '' %>" aria-label="<%= site.name %> home">
  <% if (site.logo) { %>
    <img src="/media/branding/<%= site.logo %>" alt="" class="h-8 w-auto">
  <% } else { %>
    <span class="grid h-8 w-8 place-items-center rounded-lg bg-primary-600 text-sm font-bold text-on-primary" aria-hidden="true"><%= (site.name || 'S').trim().charAt(0).toUpperCase() %></span>
  <% } %>
  <span class="text-base sm:text-lg"><%= site.name %></span>
</a>
