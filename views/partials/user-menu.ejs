<div class="relative" x-data="dropdown" @keydown.escape="close" @click.outside="close">
  <button type="button" class="flex items-center gap-2 rounded-full p-0.5 pr-2 hover:bg-slate-100 dark:hover:bg-slate-800" @click="toggle" :aria-expanded="open" aria-haspopup="menu">
    <% if (user.photo_path) { %>
      <img src="/media/avatars/<%= user.photo_path %>" alt="" class="h-8 w-8 rounded-full object-cover">
    <% } else { %>
      <span class="grid h-8 w-8 place-items-center rounded-full bg-primary-100 text-sm font-semibold text-primary-800 dark:bg-primary-900 dark:text-primary-100" aria-hidden="true"><%= user.full_name.trim().split(/\s+/).slice(0,2).map(function (p) { return p[0]; }).join('').toUpperCase() %></span>
    <% } %>
    <span class="hidden max-w-[10rem] truncate text-sm font-medium sm:block"><%= user.full_name %></span>
    <%- include('icon', { name: 'chevron', cls: 'h-4 w-4 muted' }) %>
  </button>
  <div x-cloak x-show="open" x-transition class="absolute right-0 z-40 mt-2 w-60 rounded-lg border border-slate-200 bg-white p-1 shadow-pop dark:border-slate-700 dark:bg-slate-900" role="menu">
    <div class="border-b border-slate-100 px-3 py-2 dark:border-slate-800">
      <p class="truncate text-sm font-semibold"><%= user.full_name %></p>
      <p class="truncate text-xs muted"><%= user.email %></p>
    </div>
    <a href="/dashboard" class="nav-link mt-1" role="menuitem"><%- include('icon', { name: 'home', cls: 'h-4 w-4' }) %> My dashboard</a>
    <% if (user.isStaff) { %><a href="/admin" class="nav-link" role="menuitem"><%- include('icon', { name: 'shield', cls: 'h-4 w-4' }) %> Admin</a><% } %>
    <a href="/account" class="nav-link" role="menuitem"><%- include('icon', { name: 'user', cls: 'h-4 w-4' }) %> Profile</a>
    <a href="/account/security" class="nav-link" role="menuitem"><%- include('icon', { name: 'lock', cls: 'h-4 w-4' }) %> Security</a>
    <form method="post" action="/logout" class="mt-1 border-t border-slate-100 pt-1 dark:border-slate-800">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <button type="submit" class="nav-link w-full" role="menuitem"><%- include('icon', { name: 'logout', cls: 'h-4 w-4' }) %> Sign out</button>
    </form>
  </div>
</div>
