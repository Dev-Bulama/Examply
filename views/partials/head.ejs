<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title><%= (typeof title !== 'undefined' && title && title !== site.name) ? `${title} · ${site.name}` : site.name %></title>
<meta name="description" content="<%= (typeof metaDescription !== 'undefined' && metaDescription) || site.metaDescription || '' %>">
<meta name="csrf-token" content="<%= csrfToken %>">
<meta name="color-scheme" content="light dark">
<meta property="og:title" content="<%= (typeof title !== 'undefined' && title) || site.name %>">
<meta property="og:site_name" content="<%= site.name %>">
<% if (site.ogImage) { %><meta property="og:image" content="<%= site.url %>/media/branding/<%= site.ogImage %>"><% } %>
<% if (site.favicon) { %><link rel="icon" href="/media/branding/<%= site.favicon %>"><% } else { %><link rel="icon" href="/img/favicon.svg" type="image/svg+xml"><% } %>
<link rel="preload" href="/fonts/inter-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin>
<link rel="stylesheet" href="/css/app.css?v=<%= assetVersion %>">
<link rel="stylesheet" href="/theme.css?v=<%= site.themeVersion %>">
<script src="/js/theme-init.js?v=<%= assetVersion %>"></script>
