<% const ROLE = { manager: ['badge-blue', 'Manager'], author: ['badge-green', 'Author'], member: ['badge-gray', 'Candidate'] }; %>
<div class="mb-6"><h1 class="h1">People</h1><p class="mt-1 muted"><%= u.candidates %> candidate<%= u.candidates === 1 ? '' : 's' %> · <%= u.staff %> staff<%= w.limits.candidates ? ' · plan allows ' + w.limits.candidates + ' candidates' : '' %><%= w.limits.staff_seats ? ' and ' + w.limits.staff_seats + ' staff' : '' %></p></div>
<div class="grid gap-6 xl:grid-cols-[minmax(0,1fr)_24rem]">
  <section class="card overflow-hidden">
    <div class="overflow-x-auto p-2 sm:p-0"><table class="table table-responsive">
      <thead><tr><th>Person</th><th>Role</th><th>Attempts</th><th><span class="sr-only">Actions</span></th></tr></thead>
      <tbody><% rows.forEach(function (m) { %>
        <tr>
          <td data-label="Person"><p class="font-medium"><%= m.full_name %></p><p class="text-xs muted"><%= m.email %><%= m.last_login_at ? ' · seen ' + fmt.relative(m.last_login_at) : '' %></p></td>
          <td data-label="Role">
            <% if (m.id === user.id) { %><span class="<%= ROLE[m.role][0] %>"><%= ROLE[m.role][1] %></span><% } else { %>
            <form method="post" action="/org/members/<%= m.id %>/role"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label class="sr-only" for="r<%= m.id %>">Role</label><select id="r<%= m.id %>" name="role" class="input py-1.5 text-sm" data-autosubmit><% Object.entries(ROLE).forEach(function (r) { %><option value="<%= r[0] %>" <%= m.role === r[0] ? 'selected' : '' %>><%= r[1][1] %></option><% }) %></select></form><% } %>
          </td>
          <td data-label="Attempts" class="text-sm"><%= m.attempts %></td>
          <td data-label="Actions" class="text-right"><% if (m.id !== user.id) { %><form method="post" action="/org/members/<%= m.id %>/remove" data-confirm="Remove <%= m.full_name %> from <%= w.name %>?" data-confirm-label="Remove"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn-ghost btn-sm text-red-600">Remove</button></form><% } %></td>
        </tr>
      <% }) %></tbody>
    </table></div>
  </section>
  <aside class="space-y-6">
    <form method="post" action="/org/members/invite" class="card card-body space-y-4">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <h2 class="h3">Invite people</h2>
      <div><label class="label" for="em">Email addresses</label><textarea id="em" name="emails" rows="5" class="input" placeholder="one per line, or paste a CSV&#10;ada@acme.com&#10;bayo@acme.com"></textarea><p class="hint">Up to 500 at once. Each person gets a link to join.</p></div>
      <div class="grid grid-cols-2 gap-3">
        <div><label class="label" for="ir">As</label><select id="ir" name="role" class="input"><option value="member">Candidates</option><option value="author">Authors</option><option value="manager">Managers</option></select></div>
        <div><label class="label" for="ic">Into cohort</label><select id="ic" name="cohort_id" class="input"><option value="">None</option><% cohorts.forEach(function (c) { %><option value="<%= c.id %>"><%= c.name %></option><% }) %></select></div>
      </div>
      <button class="btn-primary w-full">Send invitations</button>
    </form>
    <section class="card card-body">
      <h2 class="h3">Join code</h2>
      <% if (org.join_enabled && org.join_code) { %>
        <p class="mt-2 text-sm">Anyone signed in can join as a candidate at <span class="font-mono"><%= site.url %>/join</span> with:</p>
        <p class="mt-2 font-mono text-2xl font-bold tracking-widest"><%= org.join_code %></p>
        <div class="mt-3 flex gap-2"><form method="post" action="/org/join-code"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="enabled" value="1"><button class="btn-secondary btn-sm">New code</button></form><form method="post" action="/org/join-code"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="enabled" value="0"><button class="btn-ghost btn-sm">Turn off</button></form></div>
      <% } else { %>
        <p class="mt-2 text-sm muted">Let people join by entering a code — handy for a classroom or a training day.</p>
        <form method="post" action="/org/join-code" class="mt-3"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="enabled" value="1"><button class="btn-secondary btn-sm">Create a join code</button></form>
      <% } %>
    </section>
    <% if (invites.length) { %>
    <section class="card card-body">
      <h2 class="h3">Pending invitations (<%= invites.length %>)</h2>
      <ul class="mt-3 space-y-2 text-sm"><% invites.slice(0, 30).forEach(function (i) { %><li class="flex items-center justify-between gap-2"><span class="min-w-0 truncate"><%= i.email %> <span class="muted">· <%= ROLE[i.role][1].toLowerCase() %></span></span><form method="post" action="/org/invitations/<%= i.id %>/cancel"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn-ghost btn-sm" aria-label="Cancel invitation to <%= i.email %>">✕</button></form></li><% }) %></ul>
    </section>
    <% } %>
  </aside>
</div>
