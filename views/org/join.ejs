<div class="container-page max-w-lg py-16">
  <div class="card card-body text-center">
    <% if (inv) { %>
      <p class="text-sm muted">Invitation</p>
      <h1 class="h2 mt-1">Join <%= inv.organisation_name %></h1>
      <p class="mt-2 muted">as <%= { manager: 'a workspace manager', author: 'an author', member: 'a candidate' }[inv.role] %> · sent to <strong><%= inv.email %></strong></p>
      <% if (inv.accepted_at) { %><div class="alert-info mt-6"><p>This invitation has already been accepted.</p></div>
      <% } else if (new Date(inv.expires_at) < new Date()) { %><div class="alert-warning mt-6"><p>This invitation has expired. Ask <%= inv.organisation_name %> to send a new one.</p></div>
      <% } else if (!user) { %>
        <p class="mt-6 text-sm">Sign in (or create a free account) with <strong><%= inv.email %></strong> to accept.</p>
        <div class="mt-4 flex flex-col gap-2"><a class="btn-primary" href="/login?returnTo=<%= encodeURIComponent('/join/' + token) %>">Sign in</a><% if (site.registrationOpen) { %><a class="btn-secondary" href="/register?email=<%= encodeURIComponent(inv.email) %>">Create an account</a><% } %></div>
      <% } else { %>
        <form method="post" action="/join/<%= token %>" class="mt-6"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn-primary w-full">Accept invitation</button></form>
        <% if (user.email.toLowerCase() !== inv.email.toLowerCase()) { %><p class="mt-3 text-sm text-amber-700 dark:text-amber-400">You are signed in as <%= user.email %>. Sign in as <%= inv.email %> to accept.</p><% } %>
      <% } %>
    <% } else { %>
      <h1 class="h2">Join an organisation</h1>
      <p class="mt-2 muted">Enter the join code your trainer or employer gave you.</p>
      <form method="post" action="/join" class="mt-6 flex gap-2"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label class="sr-only" for="jc">Join code</label><input id="jc" name="code" value="<%= code %>" class="input text-center font-mono text-lg uppercase tracking-widest" maxlength="12" autocomplete="off" required><button class="btn-primary">Join</button></form>
    <% } %>
  </div>
</div>
