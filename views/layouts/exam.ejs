<!doctype html>
<html lang="en" class="<%= (htmlClasses || []).join(' ') %>" data-theme-pref="<%= themePref %>" data-theme-source="user">
<head>
  <%- include('../partials/head') %>
  <meta name="robots" content="noindex">
  <%- typeof style !== 'undefined' ? style : '' %>
</head>
<body class="min-h-screen bg-slate-50 dark:bg-slate-950" data-authenticated="1">
  <main id="main">
    <%- body %>
  </main>
  <%- include('../partials/scripts') %>
</body>
</html>
