<!doctype html>
<html lang="en" class="<%= (htmlClasses || []).join(' ') %>" data-theme-pref="<%= themePref %>" data-theme-source="user">
<head>
  <%- include('../partials/head') %>
  <%- typeof style !== 'undefined' ? style : '' %>
</head>
<body class="min-h-screen" data-authenticated="1" x-data="drawer" @keydown.escape="close">
  <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50 focus:rounded-lg focus:bg-white focus:px-4 focus:py-2 focus:shadow-pop">Skip to content</a>
  <%
    const sections = typeof navSections !== 'undefined' ? navSections : [];
    const areaLabel = typeof area !== 'undefined' && area === 'admin' ? 'Admin' : 'My account';
  %>
  <!-- Mobile drawer backdrop -->
  <div x-cloak x-show="open" x-transition.opacity class="fixed inset-0 z-40 bg-slate-900/50 lg:hidden" @click="close" aria-hidden="true"></div>
  <aside id="sidebar" class="fixed inset-y-0 left-0 z-50 flex w-72 -translate-x-full flex-col border-r border-slate-200 bg-white transition-transform duration-200 dark:border-slate-800 dark:bg-slate-950 lg:translate-x-0" :class="open && 'translate-x-0'" aria-label="<%= areaLabel %> navigation">
    <div class="flex h-16 items-center justify-between border-b border-slate-200 px-5 dark:border-slate-800">
      <%- include('../partials/brand') %>
      <button type="button" class="btn-ghost px-2 lg:hidden" @click="close" aria-label="Close menu"><%- include('../partials/icon', { name: 'x' }) %></button>
    </div>
    <nav class="flex-1 overflow-y-auto px-3 py-4">
      <p class="px-3 pb-2 text-xs font-semibold uppercase tracking-wider muted"><%= areaLabel %></p>
      <% sections.forEach(function (section) { %>
        <% if (section.heading) { %><p class="mt-5 px-3 pb-1.5 text-xs font-semibold uppercase tracking-wider text-slate-400"><%= section.heading %></p><% } %>
        <ul class="space-y-0.5">
          <% section.items.forEach(function (item) { const active = isActive(item.href, item.exact); %>
            <li><a href="<%= item.href %>" class="nav-link <%= active ? 'nav-link-active' : '' %>" <% if (active) { %>aria-current="page"<% } %>><%- include('../partials/icon', { name: item.icon }) %> <%= item.label %></a></li>
          <% }) %>
        </ul>
      <% }) %>
    </nav>
    <div class="border-t border-slate-200 p-3 dark:border-slate-800">
      <% if (typeof area !== 'undefined' && area === 'admin') { %>
        <a href="/dashboard" class="nav-link"><%- include('../partials/icon', { name: 'arrowRight' }) %> Candidate view</a>
      <% } else if (user.isStaff) { %>
        <a href="/admin" class="nav-link"><%- include('../partials/icon', { name: 'shield' }) %> Admin area</a>
      <% } %>
    </div>
  </aside>
  <div class="lg:pl-72">
    <header class="sticky top-0 z-30 flex h-16 items-center gap-3 border-b border-slate-200 bg-white/90 px-4 backdrop-blur dark:border-slate-800 dark:bg-slate-950/90 sm:px-6">
      <button type="button" class="btn-ghost px-2 lg:hidden" @click="toggle" :aria-expanded="open" aria-controls="sidebar" aria-label="Open menu"><%- include('../partials/icon', { name: 'menu' }) %></button>
      <div class="min-w-0 flex-1">
        <% if (typeof breadcrumbs !== 'undefined' && breadcrumbs.length) { %>
          <nav aria-label="Breadcrumb" class="hidden truncate text-sm muted sm:block">
            <% breadcrumbs.forEach(function (b, i) { %><% if (i) { %><span class="mx-1.5">/</span><% } %><% if (b.href) { %><a class="hover:underline" href="<%= b.href %>"><%= b.label %></a><% } else { %><span class="text-slate-700 dark:text-slate-200"><%= b.label %></span><% } %><% }) %>
          </nav>
        <% } %>
      </div>
      <%- include('../partials/theme-toggle') %>
      <%- include('../partials/user-menu') %>
    </header>
    <% if (typeof maintenanceOn !== 'undefined' && maintenanceOn) { %>
      <div class="bg-amber-100 px-4 py-2 text-center text-sm text-amber-900 dark:bg-amber-900/60 dark:text-amber-100">Maintenance mode is on — only staff can use the site.</div>
    <% } %>
    <% if (!user.email_verified_at && !(typeof area !== 'undefined' && area === 'admin')) { %>
      <div class="border-b border-amber-200 bg-amber-50 px-4 py-2.5 text-sm text-amber-900 dark:border-amber-900 dark:bg-amber-950/60 dark:text-amber-100 sm:px-6">
        <form method="post" action="/account/verify-email/resend" class="flex flex-wrap items-center gap-x-3 gap-y-1">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <span>Please verify <strong><%= user.email %></strong> to take paid or proctored exams.</span>
          <button type="submit" class="font-semibold underline">Resend link</button>
        </form>
      </div>
    <% } %>
    <main id="main" class="px-4 py-6 sm:px-6 lg:px-8 lg:py-8">
      <div class="mx-auto max-w-6xl">
        <%- include('../partials/flash') %>
        <%- body %>
      </div>
    </main>
  </div>
  <%- include('../partials/scripts') %>
</body>
</html>
