<!doctype html>
<html lang="en" class="<%= (htmlClasses || []).join(' ') %>" data-theme-pref="<%= themePref %>" <% if (user) { %>data-theme-source="user"<% } %>>
<head>
  <%- include('../partials/head') %>
  <%- typeof style !== 'undefined' ? style : '' %>
</head>
<body class="flex min-h-screen flex-col" data-authenticated="<%= user ? '1' : '0' %>">
  <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50 focus:rounded-lg focus:bg-white focus:px-4 focus:py-2 focus:shadow-pop">Skip to content</a>
  <header class="sticky top-0 z-30 border-b border-slate-200 bg-white/90 backdrop-blur dark:border-slate-800 dark:bg-slate-950/90" x-data="drawer">
    <div class="container-page flex h-16 items-center justify-between gap-4">
      <%- include('../partials/brand') %>
      <nav class="hidden items-center gap-1 lg:flex" aria-label="Main">
        <a href="/exams" class="nav-link <%= isActive('/exams') ? 'nav-link-active' : '' %>">Exams</a>
        <a href="/#features" class="nav-link">Features</a>
        <a href="/#ai" class="nav-link">AI generator</a>
        <a href="/#labs" class="nav-link">Cyber labs</a>
        <a href="/#companies" class="nav-link">For companies</a>
        <a href="/pricing" class="nav-link <%= isActive('/pricing') ? 'nav-link-active' : '' %>">Pricing</a>
        <% if (user) { %><a href="/dashboard" class="nav-link <%= isActive('/dashboard') ? 'nav-link-active' : '' %>">Dashboard</a><% } %>
      </nav>
      <div class="flex items-center gap-1 sm:gap-2">
        <%- include('../partials/bell') %>
        <%- include('../partials/theme-toggle') %>
        <% if (user) { %>
          <%- include('../partials/user-menu') %>
        <% } else { %>
          <a href="/login" class="btn-ghost hidden sm:inline-flex">Sign in</a>
          <% if (site.registrationOpen) { %><a href="/register" class="btn-primary">Create account</a><% } %>
        <% } %>
      </div>
    </div>
  </header>
  <% if (typeof maintenanceOn !== 'undefined' && maintenanceOn) { %>
    <div class="bg-amber-100 px-4 py-2 text-center text-sm text-amber-900 dark:bg-amber-900/60 dark:text-amber-100">Maintenance mode is on — only staff can use the site.</div>
  <% } %>
  <main id="main" class="flex-1">
    <%- include('../partials/announcements') %>
    <% if (flash && flash.length) { %><div class="container-page pt-6"><%- include('../partials/flash') %></div><% } %>
    <%- body %>
  </main>
  <footer class="<%= typeof landing !== 'undefined' && landing ? '' : 'mt-16 ' %>border-t border-slate-200 bg-white dark:border-slate-800 dark:bg-slate-950">
    <div class="container-page grid gap-8 py-12 text-sm sm:grid-cols-2 lg:grid-cols-5">
      <div class="sm:col-span-2 lg:col-span-1">
        <%- include('../partials/brand') %>
        <p class="mt-3 max-w-xs muted"><%= site.tagline %></p>
      </div>
      <div><p class="font-semibold">Platform</p><ul class="mt-3 space-y-2 muted"><li><a class="hover:underline" href="/exams">Exam catalogue</a></li><li><a class="hover:underline" href="/verify">Verify a certificate</a></li><li><a class="hover:underline" href="/#features">Features</a></li><li><a class="hover:underline" href="/#ai">AI exam generator</a></li><li><a class="hover:underline" href="/#labs">Cyber security labs</a></li></ul></div>
      <div><p class="font-semibold">For teams</p><ul class="mt-3 space-y-2 muted"><li><a class="hover:underline" href="/#companies">Company workspaces</a></li><li><a class="hover:underline" href="/pricing">Plans &amp; pricing</a></li><li><a class="hover:underline" href="/play">Join a live quiz</a></li></ul></div>
      <div><p class="font-semibold">Help</p><ul class="mt-3 space-y-2 muted"><li><a class="hover:underline" href="/help">Help centre</a></li><li><a class="hover:underline" href="/support">Contact support</a></li><% (typeof footerPages !== 'undefined' ? footerPages : []).forEach(function (fp) { %><li><a class="hover:underline" href="/p/<%= fp.slug %>"><%= fp.title %></a></li><% }) %></ul></div>
      <div><p class="font-semibold">Account</p><ul class="mt-3 space-y-2 muted"><% if (user) { %><li><a class="hover:underline" href="/dashboard">Dashboard</a></li><% } else { %><li><a class="hover:underline" href="/login">Sign in</a></li><% if (site.registrationOpen) { %><li><a class="hover:underline" href="/register">Create an account</a></li><% } %><% } %></ul></div>
    </div>
    <div class="border-t border-slate-200 dark:border-slate-800"><p class="container-page py-5 text-xs muted">© <%= new Date().getFullYear() %> <%= site.name %>. All rights reserved.</p></div>
  </footer>
  <%- include('../partials/scripts') %>
</body>
</html>
