<div class="mx-auto max-w-2xl">
  <h1 class="h1">Set up two-factor authentication</h1>
  <p class="mt-1 muted">This protects your account even if your password is stolen.</p>
  <div class="card mt-6">
    <div class="card-body space-y-6">
      <ol class="space-y-6">
        <li>
          <p class="font-semibold">1. Install an authenticator app</p>
          <p class="mt-1 text-sm muted">Google Authenticator, Microsoft Authenticator, Authy, 1Password and most password managers work.</p>
        </li>
        <li>
          <p class="font-semibold">2. Scan this QR code</p>
          <div class="mt-3 flex flex-col items-start gap-4 sm:flex-row sm:items-center">
            <img src="<%= qr %>" alt="QR code for your authenticator app" width="180" height="180" class="rounded-lg border border-slate-200 bg-white p-2 dark:border-slate-700">
            <div class="text-sm">
              <p class="muted">Can’t scan? Enter this key manually:</p>
              <p class="mt-2 select-all rounded-lg bg-slate-100 px-3 py-2 font-mono text-sm tracking-wider dark:bg-slate-800"><%= secretGrouped %></p>
              <button type="button" class="mt-2 text-sm link" data-copy="<%= secretGrouped.replace(/ /g, '') %>">Copy key</button>
            </div>
          </div>
        </li>
        <li>
          <p class="font-semibold">3. Enter the 6-digit code from the app</p>
          <form method="post" action="/account/security/2fa" class="mt-3 flex flex-col gap-3 sm:flex-row sm:items-start" novalidate>
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <div class="sm:w-56">
              <label for="code" class="sr-only">Authentication code</label>
              <input id="code" name="code" class="input text-center font-mono text-lg tracking-[0.3em] <%= errors.code ? 'input-error' : '' %>" inputmode="numeric" autocomplete="one-time-code" maxlength="7" required placeholder="123456" <% if (errors.code) { %>aria-invalid="true" aria-describedby="code-error"<% } %>>
              <% if (errors.code) { %><p id="code-error" class="field-error"><%= errors.code %></p><% } %>
            </div>
            <button type="submit" class="btn-primary">Verify and turn on</button>
          </form>
        </li>
      </ol>
    </div>
  </div>
  <% if (!user.mustEnroll2fa) { %><p class="mt-4 text-sm"><a href="/account/security" class="link">Cancel</a></p><% } %>
</div>
