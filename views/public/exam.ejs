<%
  const s = summary;
  const reasons = elig ? elig.reasons : [];
  const inProgress = elig && elig.inProgress;
  const fmtMin = function (m) { if (!m) return 'Untimed'; return m >= 60 ? Math.floor(m / 60) + ' h' + (m % 60 ? ' ' + (m % 60) + ' min' : '') : m + ' min'; };
%>
<section class="border-b border-slate-200 bg-gradient-to-b from-primary-50 to-white dark:border-slate-800 dark:from-primary-950/40 dark:to-slate-950">
  <div class="container-page py-10">
    <nav class="text-sm muted" aria-label="Breadcrumb"><a class="hover:underline" href="/exams">Exams</a><% if (exam.category_name) { %> / <%= exam.category_name %><% } %></nav>
    <div class="mt-3 flex flex-wrap items-center gap-2"><span class="badge-blue"><%= EXAM_TYPES[exam.type] %></span><% if (exam.exam_code) { %><span class="badge-gray"><%= exam.exam_code %></span><% } %><% if (exam.difficulty_label) { %><span class="badge-gray"><%= exam.difficulty_label %></span><% } %></div>
    <h1 class="mt-3 max-w-4xl text-3xl font-bold tracking-tight sm:text-4xl"><%= exam.title %></h1>
    <% if (exam.short_description) { %><p class="mt-3 max-w-3xl text-lg muted"><%= exam.short_description %></p><% } %>
    <dl class="mt-6 grid max-w-3xl grid-cols-2 gap-3 sm:grid-cols-4">
      <% [['Questions', s.questionCount], ['Time', fmtMin(s.durationMinutes)], ['Pass mark', s.passMark !== null ? s.passMark + (s.passMarkType === 'raw' ? ' marks' : '%') : (s.bands.length ? 'Bands' : '—')], ['Attempts', s.maxAttempts || 'Unlimited']].forEach(function (k) { %>
      <div class="rounded-xl border border-slate-200 bg-white p-3 dark:border-slate-800 dark:bg-slate-900"><dt class="text-xs muted"><%= k[0] %></dt><dd class="mt-1 text-lg font-semibold"><%= k[1] %></dd></div>
      <% }) %>
    </dl>
  </div>
</section>

<div class="container-page grid gap-8 py-10 lg:grid-cols-[minmax(0,1fr)_22rem]">
  <div class="min-w-0 space-y-8">
    <% if (exam.description_html) { %><section class="prose-content max-w-none"><%- exam.description_html %></section><% } %>
    <% if (domains.length) { %>
    <section>
      <h2 class="h2">What it covers</h2>
      <ul class="mt-4 space-y-3">
        <% domains.forEach(function (d) { %>
        <li><div class="flex justify-between text-sm"><span><span class="font-mono text-xs muted"><%= d.code %></span> <%= d.name %></span><span class="muted"><%= Number(d.weight_percent) %>%</span></div>
          <div class="mt-1 h-1.5 rounded-full bg-slate-100 dark:bg-slate-800"><div class="h-1.5 rounded-full bg-primary-500" style="width: <%= Math.min(100, Number(d.weight_percent)) %>%"></div></div></li>
        <% }) %>
      </ul>
    </section>
    <% } %>
    <section id="instructions" class="card">
      <div class="card-body">
        <p class="text-xs font-semibold uppercase tracking-wider text-primary-700 dark:text-primary-300">Instructions</p>
        <p class="mt-2"><%= instructions.intro %></p>
        <% if (instructions.customBefore) { %><div class="mt-4 whitespace-pre-line rounded-lg border-l-4 border-primary-500 bg-primary-50 p-4 text-sm dark:bg-primary-950/40"><%= instructions.customBefore %></div><% } %>
        <% instructions.sections.forEach(function (sec) { %>
        <h3 class="mt-6 font-semibold"><%= sec.heading %></h3>
        <ul class="mt-2 list-disc space-y-1.5 pl-5 text-sm leading-relaxed text-slate-700 dark:text-slate-300"><% sec.items.forEach(function (it) { %><li><%= it %></li><% }) %></ul>
        <% }) %>
        <% if (instructions.customAfter) { %><div class="mt-6 whitespace-pre-line rounded-lg bg-slate-50 p-4 text-sm dark:bg-slate-800/60"><%= instructions.customAfter %></div><% } %>
      </div>
    </section>
  </div>

  <aside class="space-y-4 lg:sticky lg:top-24 lg:self-start" id="start">
    <div class="card card-body">
      <p class="text-2xl font-bold"><% if (!exam.is_paid) { %>Free<% } else { %><%= fmt.money(exam.sale_price_kobo || exam.price_kobo) %><% } %></p>
      <% if (exam.certificate_enabled) { %><p class="mt-1 flex items-center gap-1.5 text-sm text-emerald-700 dark:text-emerald-400"><%- include('../partials/icon', { name: 'academic', cls: 'h-4 w-4' }) %> Verifiable certificate when you pass</p><% } %>
      <% if (!user && exam.is_paid && buyProduct) { %>
        <a href="/login?returnTo=<%= encodeURIComponent('/checkout/' + buyProduct.slug) %>" class="btn-primary mt-5 w-full">Sign in to buy</a>
      <% } else if (!user) { %>
        <a href="/login?returnTo=<%= encodeURIComponent('/exams/' + exam.slug) %>" class="btn-primary mt-5 w-full">Sign in to start</a>
        <% if (site.registrationOpen) { %><a href="/register" class="btn-secondary mt-2 w-full">Create a free account</a><% } %>
      <% } else if (inProgress) { %>
        <p class="mt-4 text-sm">You have an attempt in progress<%= inProgress.expires_at ? ' — the timer is still running' : '' %>.</p>
        <a href="/attempts/<%= inProgress.uuid %>" class="btn-primary mt-4 w-full">Resume exam</a>
      <% } else if (elig.ok) { %>
        <form method="post" action="/exams/<%= exam.slug %>/start" class="mt-5 space-y-4">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <label class="flex items-start gap-2 text-sm"><input type="checkbox" name="accept" value="1" class="checkbox mt-0.5" required> I have read the instructions<%= s.durationMinutes ? ' and I am ready to start the timer' : '' %>.</label>
          <button class="btn-primary w-full">Start exam</button>
        </form>
        <% if (elig.attemptsAllowed !== null) { %><p class="mt-3 text-center text-xs muted">Attempt <%= elig.attemptsUsed + 1 %> of <%= elig.attemptsAllowed %></p><% } %>
      <% } else { %>
        <div class="mt-4 space-y-2">
          <% reasons.forEach(function (r) { %><p class="flex gap-2 text-sm"><span class="mt-0.5 text-amber-600"><%- include('../partials/icon', { name: 'info', cls: 'h-4 w-4' }) %></span><%= r.message %></p><% }) %>
        </div>
        <% if (reasons.some(function (r) { return r.code === 'invite'; })) { %>
        <form method="post" action="/exams/<%= exam.slug %>/invite" class="mt-4 flex gap-2">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <label class="sr-only" for="inv">Invite code</label><input id="inv" name="invite_code" class="input" placeholder="Invite code" autocomplete="off" required>
          <button class="btn-secondary">Apply</button>
        </form>
        <% } %>
        <% if (reasons.some(function (r) { return r.code === 'verify_email'; })) { %><a href="/account" class="btn-secondary mt-4 w-full">Verify my email</a><% } %>
        <% if (elig.needsPurchase && buyProduct) { %><a href="/checkout/<%= buyProduct.slug %>" class="btn-primary mt-4 w-full">Buy now · <%= fmt.money(buyProduct.sale_price_kobo || buyProduct.price_kobo, buyProduct.currency) %></a><p class="mt-2 text-center text-xs muted">Card, bank, USSD or bank transfer</p><% } else if (elig.needsPurchase) { %><p class="mt-4 text-sm muted">This exam is not on sale right now.</p><% } %>
        <% if (attemptsProduct && reasons.some(function (r) { return r.code === 'attempts'; }) && !elig.needsPurchase) { %><a href="/checkout/<%= attemptsProduct.slug %>" class="btn-secondary mt-4 w-full">Buy another attempt · <%= fmt.money(attemptsProduct.price_kobo, attemptsProduct.currency) %></a><% } %>
      <% } %>
    </div>
    <% if (history.length) { %>
    <div class="card card-body">
      <h2 class="h3">Your attempts</h2>
      <ul class="mt-3 divide-y divide-slate-200 text-sm dark:divide-slate-800">
        <% history.forEach(function (h) { %>
        <li class="flex items-center justify-between py-2">
          <a class="link" href="<%= h.status === 'in_progress' ? '/attempts/' + h.uuid : '/results/' + h.uuid %>"><%= h.mode === 'study' ? 'Weak-area practice' : 'Attempt ' + h.attempt_no %></a>
          <span class="muted"><% if (h.status === 'in_progress') { %>In progress<% } else if (h.release_status !== 'released') { %>Awaiting release<% } else { %><%= Number(h.percent) %>%<%= h.passed === null ? (h.band ? ' · ' + h.band : '') : h.passed ? ' · Pass' : ' · Fail' %><% } %></span>
        </li>
        <% }) %>
      </ul>
    </div>
    <% } %>
  </aside>
</div>
