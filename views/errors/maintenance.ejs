<section class="container-page grid min-h-[60vh] place-items-center py-16 text-center">
  <div class="max-w-lg">
    <p class="text-sm font-semibold uppercase tracking-wider text-primary-700 dark:text-primary-300">Maintenance</p>
    <h1 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl">We’ll be right back</h1>
    <p class="mt-4 muted"><%= typeof message !== 'undefined' && message ? message : 'We are performing scheduled maintenance.' %></p>
    <div class="mt-8 flex flex-wrap justify-center gap-3">
      <a href="/login" class="btn-secondary">Staff sign in</a>
    </div>
    <% if (typeof stack !== 'undefined' && stack) { %><pre class="mt-8 max-h-80 overflow-auto rounded-lg bg-slate-900 p-4 text-left text-xs text-slate-100"><%= stack %></pre><% } %>
  </div>
</section>
