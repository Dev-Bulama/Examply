<section class="container-page grid min-h-[60vh] place-items-center py-16 text-center">
  <div class="max-w-lg">
    <p class="text-sm font-semibold uppercase tracking-wider text-primary-700 dark:text-primary-300">Error 500</p>
    <h1 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl">Something went wrong</h1>
    <p class="mt-4 muted"><%= typeof message !== 'undefined' && message ? message : 'Something went wrong on our side. The error has been logged and we will look into it.' %></p>
    <div class="mt-8 flex flex-wrap justify-center gap-3">
      <a href="/" class="btn-primary">Go to the home page</a><% if (user) { %><a href="/dashboard" class="btn-secondary">My dashboard</a><% } %>
    </div>
    <% if (typeof stack !== 'undefined' && stack) { %><pre class="mt-8 max-h-80 overflow-auto rounded-lg bg-slate-900 p-4 text-left text-xs text-slate-100"><%= stack %></pre><% } %>
  </div>
</section>
