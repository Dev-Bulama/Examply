<% if (sent) { %>
  <h1 class="h2">Check your email</h1>
  <p class="mt-3 text-sm muted">If an account exists for <strong class="text-slate-900 dark:text-slate-100"><%= sent %></strong>, we have sent a link to reset the password. The link works once and expires in 60 minutes.</p>
  <p class="mt-3 text-sm muted">Didn’t get it? Check your spam folder, or <a href="/forgot-password" class="link">try again</a> in a minute.</p>
  <a href="/login" class="btn-secondary mt-6 w-full">Back to sign in</a>
<% } else { %>
  <h1 class="h2">Forgot your password?</h1>
  <p class="mt-1 text-sm muted">Enter your email and we’ll send you a reset link.</p>
  <form method="post" action="/forgot-password" class="mt-6 space-y-4" novalidate>
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <%- include('../partials/field', { name: 'email', label: 'Email', type: 'email', required: true, autocomplete: 'email' }) %>
    <button type="submit" class="btn-primary w-full" data-loading-text="Sending…">Send reset link</button>
  </form>
  <p class="mt-6 text-center text-sm"><a href="/login" class="link">Back to sign in</a></p>
<% } %>
