<h1 class="h2">Create your account</h1>
<p class="mt-1 text-sm muted">It takes less than a minute.</p>
<form method="post" action="/register" class="mt-6 space-y-4" novalidate>
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
  <%- include('../partials/field', { name: 'full_name', label: 'Full name', required: true, autocomplete: 'name', maxlength: 150, hint: 'Exactly as it should appear on your certificates.' }) %>
  <%- include('../partials/field', { name: 'email', label: 'Email', type: 'email', required: true, autocomplete: 'email' }) %>
  <%- include('../partials/field', { name: 'password', label: 'Password', type: 'password', required: true, autocomplete: 'new-password', hint: policyText }) %>
  <%- include('../partials/field', { name: 'password_confirmation', label: 'Confirm password', type: 'password', required: true, autocomplete: 'new-password' }) %>
  <%- include('../partials/field', { name: 'accept_terms', label: 'I agree to the Terms of Use and Privacy Policy', type: 'checkbox' }) %>
  <button type="submit" class="btn-primary w-full" data-loading-text="Creating account…">Create account</button>
</form>
<% if (site.googleEnabled) { %>
  <div class="my-6 flex items-center gap-3 text-xs muted"><span class="h-px flex-1 bg-slate-200 dark:bg-slate-700"></span>or<span class="h-px flex-1 bg-slate-200 dark:bg-slate-700"></span></div>
  <a href="/auth/google" class="btn-secondary w-full">Sign up with Google</a>
<% } %>
<p class="mt-6 text-center text-sm muted">Already have an account? <a href="/login" class="link">Sign in</a></p>
